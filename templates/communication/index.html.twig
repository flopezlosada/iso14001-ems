{% extends 'app_shell.html.twig' %}

{% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::COMMUNICATION')) %}

{% block title %}Comunicaciones{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Comunicaciones{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Comunicaciones</h1>
            <p class="lead">Registro de comunicaciones internas y externas, consultas y quejas de las partes interesadas (RG-07.04.00, §7.4).</p>
        </div>
        {% if can_write %}
            <div>
                <a class="btn" href="{{ path('communication_new') }}">+ Registrar comunicación</a>
            </div>
        {% endif %}
    </div>

    <div class="card">
        {% if communications is empty %}
            <div class="empty-state">
                <h2>Aún no hay comunicaciones registradas</h2>
                <p>Registra la primera comunicación, consulta o queja del centro.</p>
                {% if can_write %}
                    <a class="btn" href="{{ path('communication_new') }}">Registrar la primera</a>
                {% endif %}
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr>
                        <th>Fecha</th><th>Ámbito {{ help_button('comunicacion-ambito') }}</th><th>Tipo</th><th>Canal</th><th>Mensaje</th><th>Parte interesada</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for communication in communications %}
                        <tr>
                            <td class="mono">{{ communication.occurredOn|date('d/m/Y') }}</td>
                            <td>{{ communication.scope.label }}</td>
                            <td>{{ communication.category.label }}</td>
                            <td class="muted">{{ communication.channel.label }}</td>
                            <td>{{ communication.subject }}</td>
                            <td class="muted">{{ communication.interestedParty ? communication.interestedParty.name : '—' }}</td>
                            <td>
                                {% if can_write %}
                                    <a href="{{ path('communication_edit', { id: communication.id }) }}">Editar</a>
                                    <form method="post" action="{{ path('communication_delete', { id: communication.id }) }}" data-confirm="¿Eliminar la comunicación «{{ communication.subject|e('html_attr') }}»?" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_communication' ~ communication.id) }}">
                                        <button type="submit" class="btn secondary">Eliminar</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
