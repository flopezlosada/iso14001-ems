{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Registrar' : 'Editar' }} aspecto ambiental{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('aspect_index') }}">Aspectos ambientales</a><span class="sep">/</span>
    {{ isNew ? 'Registrar' : aspect.name }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Registrar aspecto ambiental' : 'Editar ' ~ aspect.name }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.name, form.type, form.category, form.unit, form.associatedImpact, form.active]) }}
            {{ f.actions(path('aspect_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
