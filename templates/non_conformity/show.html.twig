{% extends 'app_shell.html.twig' %}

{% block title %}{{ nonConformity.reference }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('non_conformity_index') }}">No conformidades</a><span class="sep">/</span>
    {{ nonConformity.reference }}
{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::NONCONFORMITY')) %}
    <div class="page-head">
        <div>
            <h1 class="mono">{{ nonConformity.reference }} <span class="badge {{ nonConformity.status.badgeClass }}">{{ nonConformity.status.label }}</span> {{ help_button('nc-estado') }}</h1>
            <p class="lead">{{ nonConformity.origin.label }}{% if nonConformity.originDetail %} · {{ nonConformity.originDetail }}{% endif %}</p>
        </div>
        <div class="page-actions">
            {% if can_write %}
                {% set st = nonConformity.status.value %}
                {% if st == 'open' %}
                    <form method="post" action="{{ path('non_conformity_change_status', { id: nonConformity.id }) }}" class="inline-form" data-confirm="¿Iniciar el tratamiento de esta no conformidad?">
                        <input type="hidden" name="_token" value="{{ csrf_token('non_conformity_status' ~ nonConformity.id) }}">
                        <input type="hidden" name="status" value="in_treatment">
                        <button class="btn secondary" type="submit">Iniciar tratamiento</button>
                    </form>
                {% elseif st == 'in_treatment' %}
                    {% if nonConformity.canBeClosed %}
                        <form method="post" action="{{ path('non_conformity_change_status', { id: nonConformity.id }) }}" class="inline-form" data-confirm="¿Cerrar esta no conformidad? No queda ninguna acción pendiente de verificar y al menos una ha resultado eficaz.">
                            <input type="hidden" name="_token" value="{{ csrf_token('non_conformity_status' ~ nonConformity.id) }}">
                            <input type="hidden" name="status" value="closed">
                            <button class="btn secondary" type="submit">Resolver y cerrar</button>
                        </form>
                    {% else %}
                        <button class="btn secondary" type="button" disabled title="Para cerrar: no puede quedar ninguna acción pendiente de verificar y al menos una debe ser eficaz (OK). Una acción no eficaz no bloquea; añade otra que resuelva la causa.">Resolver y cerrar</button>
                    {% endif %}
                {% elseif st == 'closed' %}
                    <form method="post" action="{{ path('non_conformity_change_status', { id: nonConformity.id }) }}" class="inline-form" data-confirm="¿Reabrir esta no conformidad? Volverá a estado 'En tratamiento'.">
                        <input type="hidden" name="_token" value="{{ csrf_token('non_conformity_status' ~ nonConformity.id) }}">
                        <input type="hidden" name="status" value="in_treatment">
                        <button class="btn secondary" type="submit">Reabrir</button>
                    </form>
                {% endif %}
            {% endif %}
            <a class="btn secondary" href="{{ path('non_conformity_edit', { id: nonConformity.id }) }}">Editar no conformidad</a>
        </div>
    </div>

    <div class="card">
        <dl class="detail-grid">
            <dt>Fecha de apertura</dt><dd>{{ nonConformity.openedAt|date('d/m/Y') }}</dd>
            <dt>Fecha de cierre</dt><dd>{{ nonConformity.closedAt ? nonConformity.closedAt|date('d/m/Y') : '—' }}</dd>
            <dt>Proceso afectado</dt><dd>{{ nonConformity.affectedProcess ? nonConformity.affectedProcess.label : '—' }}</dd>
            <dt>Apartado ISO 14001</dt><dd>{{ nonConformity.isoClause ?? '—' }}</dd>
            <dt>Responsable</dt><dd>{{ nonConformity.responsible ? nonConformity.responsible.fullName : '—' }}</dd>
        </dl>
        <h2>Descripción</h2>
        <p>{{ nonConformity.description|nl2br }}</p>
        <h2>Análisis de causas {{ help_button('nc-causa-raiz') }}</h2>
        <p>{{ nonConformity.rootCause ? nonConformity.rootCause|nl2br : '—' }}</p>
    </div>

    <div class="page-head">
        <h2>Acciones correctivas (PAC) {{ help_button('nc-accion-correctiva') }}</h2>
        <a class="btn" href="{{ path('corrective_action_new', { id: nonConformity.id }) }}">+ Añadir acción</a>
    </div>

    <div class="card">
        {% if nonConformity.correctiveActions is empty %}
            <div class="empty-state">
                <h2>Aún no hay acciones correctivas</h2>
                <p>Añade la primera acción del plan para eliminar la causa de la no conformidad.</p>
            </div>
        {% else %}
            {# Las acciones tienen textos largos (descripción, evidencia): fichas, no tabla. #}
            {% for action in nonConformity.correctiveActions %}
                <div class="action-item">
                    <p class="action-desc"><span class="mono muted">{{ action.reference }}</span> · {{ action.description|nl2br }}</p>
                    <div class="action-meta">
                        <span class="meta-item"><span class="meta-label">Responsable</span>{{ action.responsible ? action.responsible.fullName : '—' }}</span>
                        <span class="meta-item"><span class="meta-label">Prevista</span>{{ action.plannedDate ? action.plannedDate|date('d/m/Y') : '—' }}</span>
                        <span class="meta-item"><span class="meta-label">Autorización</span>
                            {%- if action.requiresDirectionAuthorization -%}
                                {% if action.authorizedBy %}
                                    <span class="badge badge--success">Autorizada</span>
                                {% else %}
                                    <span class="badge badge--warning">Pendiente</span>
                                {% endif %}
                            {%- else -%}<span class="muted">No requiere</span>{%- endif -%}
                        </span>
                        <span class="meta-item"><span class="meta-label">Eficacia</span>
                            {%- if action.efficacy -%}
                                <span class="badge {{ action.efficacy.badgeClass }}">{{ action.efficacy.label }}</span>
                            {%- else -%}<span class="badge badge--warning">Pendiente</span>{%- endif -%}
                        </span>
                    </div>
                    {% if action.implementationEvidence %}
                        <div class="action-efficacy"><span class="meta-label">Evidencia de implementación</span>{{ action.implementationEvidence|nl2br }}</div>
                    {% endif %}
                    <div class="action-actions">
                        {% if action.requiresDirectionAuthorization and not action.authorizedBy and can_write %}
                            <form method="post" action="{{ path('corrective_action_authorize', { id: nonConformity.id, actionId: action.id }) }}" class="inline-form" data-confirm="¿Autorizar esta acción correctiva? Quedará autorizada por ti con la fecha de hoy.">
                                <input type="hidden" name="_token" value="{{ csrf_token('corrective_action_authorize' ~ action.id) }}">
                                <button class="btn secondary" type="submit">Autorizar</button>
                            </form>
                        {% endif %}
                        {% if action.efficacy is null and can_write %}
                            <span class="action-eval">
                                <span class="meta-label">Eficacia {{ help_button('nc-eficacia') }}</span>
                                <form method="post" action="{{ path('corrective_action_evaluate', { id: nonConformity.id, actionId: action.id }) }}" class="inline-form" data-confirm="¿Marcar esta acción como EFICAZ? Se registrará con tu nombre y la fecha de hoy.">
                                    <input type="hidden" name="_token" value="{{ csrf_token('corrective_action_evaluate' ~ action.id) }}">
                                    <input type="hidden" name="result" value="ok">
                                    <button class="btn secondary" type="submit">Eficaz</button>
                                </form>
                                <form method="post" action="{{ path('corrective_action_evaluate', { id: nonConformity.id, actionId: action.id }) }}" class="inline-form" data-confirm="¿Marcar esta acción como NO eficaz? Se registrará con tu nombre y la fecha de hoy.">
                                    <input type="hidden" name="_token" value="{{ csrf_token('corrective_action_evaluate' ~ action.id) }}">
                                    <input type="hidden" name="result" value="not_ok">
                                    <button class="btn secondary" type="submit">No eficaz</button>
                                </form>
                            </span>
                        {% endif %}
                        <a href="{{ path('corrective_action_edit', { id: nonConformity.id, actionId: action.id }) }}">Editar acción</a>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
