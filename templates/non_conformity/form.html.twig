{% extends 'app_shell.html.twig' %}

{% block title %}{{ isNew ? 'Registrar' : 'Editar' }} no conformidad{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('non_conformity_index') }}">No conformidades</a><span class="sep">/</span>
    {{ isNew ? 'Registrar' : nonConformity.reference }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Registrar no conformidad' : 'Editar ' ~ nonConformity.reference }}</h1>
    </div>

    <div class="card" style="max-width: 640px;">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {% for field in [form.openedAt, form.origin, form.originDetail, form.affectedProcess, form.isoClause, form.description, form.rootCause, form.responsible, form.status] %}
                <div class="form-row">
                    {{ form_label(field) }}
                    {{ form_widget(field) }}
                    {% if field.vars.help %}<p class="help">{{ field.vars.help }}</p>{% endif %}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
            <button class="btn" type="submit">Guardar</button>
            <a class="btn secondary" href="{{ path('non_conformity_index') }}">Cancelar</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
