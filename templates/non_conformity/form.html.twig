{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Registrar' : 'Editar' }} no conformidad{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('non_conformity_index') }}">No conformidades</a><span class="sep">/</span>
    {{ isNew ? 'Registrar' : nonConformity.reference }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Registrar no conformidad' : 'Editar ' ~ nonConformity.reference }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.openedAt, form.origin, form.originDetail, form.affectedProcess, form.isoClause, form.description, form.rootCause, form.responsible, form.status]) }}
            {{ f.actions(path('non_conformity_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
