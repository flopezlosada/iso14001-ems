{% extends 'app_shell.html.twig' %}

{% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::INTERESTED_PARTY')) %}

{% block title %}Partes interesadas {{ year }}{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Partes interesadas{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Partes interesadas {{ year }}</h1>
            <p class="lead">Identificación y evaluación de las necesidades y expectativas de las partes interesadas (F.04.0).</p>
        </div>
        {% if can_write %}
            <a class="btn" href="{{ path('interested_party_new', { year: year }) }}">+ Añadir parte interesada</a>
        {% endif %}
    </div>

    <div class="toolbar">
        <span class="mono muted">
            <a class="btn secondary" href="{{ path('interested_party_year', { year: year - 1 }) }}">← {{ year - 1 }}</a>
            <a class="btn secondary" href="{{ path('interested_party_year', { year: year + 1 }) }}">{{ year + 1 }} →</a>
        </span>
    </div>

    <div class="card">
        {% if parties is empty %}
            <div class="empty-state">
                <h2>Aún no hay partes interesadas en {{ year }}</h2>
                <p>Empieza identificando la primera parte interesada del análisis.</p>
                {% if can_write %}
                    <a class="btn" href="{{ path('interested_party_new', { year: year }) }}">Añadir la primera</a>
                {% endif %}
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr>
                        <th>Parte interesada</th><th>Necesidades y expectativas</th><th>Incidencias</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for party in parties %}
                        <tr>
                            <td>{{ party.name }}</td>
                            <td>{{ party.needsAndExpectations }}</td>
                            <td class="muted">{{ party.incidents ?? '—' }}</td>
                            <td>
                                {% if can_write %}
                                    <a href="{{ path('interested_party_edit', { year: year, id: party.id }) }}">Editar</a>
                                    <form method="post" action="{{ path('interested_party_delete', { year: year, id: party.id }) }}" onsubmit="return confirm('¿Eliminar la parte interesada «{{ party.name|e('js') }}»?');" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_interested_party' ~ party.id) }}">
                                        <button type="submit" class="btn secondary">Eliminar</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
