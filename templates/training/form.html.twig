{% extends 'app_shell.html.twig' %}

{% block title %}{{ action.id ? 'Editar' : 'Nueva' }} acción formativa · {{ year }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('training_year', { year: year }) }}">Formación {{ year }}</a><span class="sep">/</span>
    {{ action.id ? 'Editar' : 'Nueva' }} acción formativa
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ action.id ? 'Editar acción formativa' : 'Nueva acción formativa' }} · {{ year }}</h1>
    </div>

    <div class="card" style="max-width: 560px;">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {% for field in [form.description, form.type, form.targetAudience, form.objectives, form.plannedDate, form.methodology, form.actualDate, form.efficacyEvaluation] %}
                <div class="form-row">
                    {{ form_label(field) }}
                    {{ form_widget(field) }}
                    {% if field.vars.help %}<p class="help">{{ field.vars.help }}</p>{% endif %}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
            <button class="btn" type="submit">Guardar</button>
            <a class="btn secondary" href="{{ path('training_year', { year: year }) }}">Cancelar</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
