{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ action.id ? 'Editar' : 'Nueva' }} acción formativa · {{ year }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('training_year', { year: year }) }}">Formación {{ year }}</a><span class="sep">/</span>
    {{ action.id ? 'Editar' : 'Nueva' }} acción formativa
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ action.id ? 'Editar acción formativa' : 'Nueva acción formativa' }} · {{ year }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.section('El curso', [form.description, form.type, form.targetAudience, form.objectives]) }}
            {{ f.section('Planificación', [form.plannedDate, form.methodology]) }}
            {{ f.section('Ejecución y eficacia', [form.actualDate, form.efficacyEvaluation]) }}
            {% if action.needsReview %}
                {{ f.section('Revisión pendiente', [form.reviewNote, form.needsReview]) }}
            {% endif %}
            {{ f.actions(path('training_year', { year: year })) }}
        {{ form_end(form, { render_rest: false }) }}
    </div>
{% endblock %}
