{% extends 'app_shell.html.twig' %}

{% set day_names = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'] %}
{% set month_names = ['', 'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'] %}

{% block title %}Inicio{% endblock %}

{% block breadcrumb %}Inicio{% endblock %}

{% block body %}
    {# --- Saludo: la cara amable de la pantalla --- #}
    <section class="dash-greeting">
        <div>
            <p class="eyebrow">{{ day_names[today|date('w')] }} · {{ today|date('j') }} de {{ month_names[today|date('n')] }}</p>
            <h1>{{ greeting }}, {{ firstName }}.</h1>
            <p class="lead">
                {% if hasObligations %}
                    Esto es lo que te toca del sistema de gestión ambiental.
                {% else %}
                    Bienvenida al sistema de gestión ambiental.
                {% endif %}
            </p>
        </div>
        <div class="brand-mark brand-mark--lg dash-mark">{{ include('partials/_brand_mark.html.twig', { size: 72 }) }}</div>
    </section>

    {# --- "Lo que me toca": el núcleo de la pantalla --- #}
    {% if hasObligations %}
        {# Semáforo: tres cifras que resumen el estado de MIS obligaciones con fecha. #}
        <div class="worklist-stats">
            <a class="stat stat--danger {{ counts.overdue == 0 ? 'is-zero' }}" href="{{ path('obligation_index') }}#overdue">
                <span class="stat-figure">{{ counts.overdue }}</span>
                <span class="stat-label">Vencida{{ counts.overdue == 1 ? '' : 's' }}</span>
            </a>
            <a class="stat stat--warning {{ counts.due_soon == 0 ? 'is-zero' }}" href="{{ path('obligation_index') }}#due_soon">
                <span class="stat-figure">{{ counts.due_soon }}</span>
                <span class="stat-label">Próxima{{ counts.due_soon == 1 ? '' : 's' }} a vencer</span>
            </a>
            <a class="stat stat--success {{ counts.on_track == 0 ? 'is-zero' }}" href="{{ path('obligation_index') }}#on_track">
                <span class="stat-figure">{{ counts.on_track }}</span>
                <span class="stat-label">Al día</span>
            </a>
        </div>

        {% if actionable is empty %}
            {# Tiene obligaciones, pero ninguna vencida ni próxima: refuerzo positivo. #}
            <section class="panel worklist-clear">
                <p><span class="badge badge--success">Al día</span></p>
                <p class="muted">Nada vencido ni próximo a vencer. Te avisaremos cuando toque.</p>
            </section>
        {% else %}
            <p class="eyebrow dash-section-label">Pendiente de ti</p>
            <ul class="worklist">
                {% for item in actionable %}
                    {% set is_overdue = item.urgency.value == 'overdue' %}
                    <li class="worklist-item">
                        <span class="badge {{ is_overdue ? 'badge--danger' : 'badge--warning' }}">{{ item.urgency.label }}</span>
                        <div class="worklist-main">
                            <a class="worklist-title" href="{{ path('document_show', { id: item.id }) }}">{{ item.title }}</a>
                            {% if item.code %}<span class="worklist-code mono muted">{{ item.code }}</span>{% endif %}
                        </div>
                        <span class="worklist-due {{ is_overdue ? 'is-overdue' : 'muted' }}">
                            {%- if item.daysUntil is null -%}
                                —
                            {%- elseif item.daysUntil < 0 -%}
                                venció hace {{ -item.daysUntil }} día{{ item.daysUntil == -1 ? '' : 's' }}
                            {%- elseif item.daysUntil == 0 -%}
                                vence hoy
                            {%- else -%}
                                vence en {{ item.daysUntil }} día{{ item.daysUntil == 1 ? '' : 's' }}
                            {%- endif -%}
                        </span>
                        {% if item.route %}
                            <a class="btn" href="{{ path(item.route) }}">Rellenar</a>
                        {% else %}
                            {# Sin módulo CRUD propio (p. ej. la Política Ambiental): se gestiona desde
                               su ficha de control documental, no desde una pantalla de captura de datos. #}
                            <a class="btn secondary" href="{{ path('document_show', { id: item.id }) }}">Abrir ficha</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <p class="worklist-links">
            <a href="{{ path('obligation_index') }}">Ver todo lo que toca →</a>
            <a href="{{ path('obligation_structure') }}">Ver la estructura del SGA →</a>
        </p>
    {% endif %}

    {# --- Estado del sistema: el mapa global por bloques PDCA (lo que ve cada rol según permisos) --- #}
    {% if systemGroups is not empty %}
        <section class="system-overview">
            <p class="eyebrow dash-section-label">El sistema · curso {{ schoolYear }}</p>
            {% for group in systemGroups %}
                <div class="system-phase">
                    <h2 class="system-phase-title">{{ group.phase.label }}</h2>
                    <div class="module-grid">
                        {% for module in group.modules %}
                            <a class="module-card module-card--{{ module.health.value }}" href="{{ path(module.area.indexRoute) }}">
                                <span class="module-card-name">{{ module.area.label }}</span>
                                <span class="badge {{ module.health.badgeClass }}">{{ module.summary }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    {# --- Aspectos a vigilar: aviso proactivo (mismo que en "Qué toca"); no en el estado vacío --- #}
    {% if not hasNothing %}{{ include('partials/_aspects_to_watch.html.twig') }}{% endif %}

    {# --- Estado de la plataforma + actividad reciente (solo admin) --- #}
    {% if admin %}
        <section class="panel dash-admin">
            <p class="eyebrow">La plataforma</p>
            <p class="muted">{{ admin.userCount }} usuario{{ admin.userCount == 1 ? '' : 's' }} con acceso · {{ admin.roleCount }} rol{{ admin.roleCount == 1 ? '' : 'es' }} definido{{ admin.roleCount == 1 ? '' : 's' }}.</p>

            <div class="quick-links dash-admin-links">
                <a class="quick-link" href="{{ path('admin_user_index') }}">
                    <span class="quick-link-title">Usuarios</span>
                    <span class="quick-link-desc">Quién tiene acceso al sistema.</span>
                </a>
                <a class="quick-link" href="{{ path('admin_role_index') }}">
                    <span class="quick-link-title">Roles y permisos</span>
                    <span class="quick-link-desc">Qué puede hacer cada rol en cada área.</span>
                </a>
                <a class="quick-link" href="{{ path('audit_index') }}">
                    <span class="quick-link-title">Registro de actividad</span>
                    <span class="quick-link-desc">Todo lo que ocurre en la plataforma.</span>
                </a>
            </div>

            <p class="eyebrow dash-subhead">Actividad reciente</p>
            {% if admin.recent is empty %}
                <p class="muted">Todavía no hay eventos registrados.</p>
            {% else %}
                <ul class="activity">
                    {% for entry in admin.recent %}
                        <li>
                            <span class="activity-when mono">{{ entry.occurredAt|date('d/m H:i') }}</span>
                            <span class="activity-what">{{ entry.summary ?? entry.action }}</span>
                            <span class="activity-who muted">{{ entry.actor ?? 'sistema' }}</span>
                        </li>
                    {% endfor %}
                </ul>
                <a class="activity-more" href="{{ path('audit_index') }}">Ver todo el registro →</a>
            {% endif %}
        </section>
    {% endif %}

    {# --- Usuario sin gestiones asignadas todavía --- #}
    {% if hasNothing %}
        <div class="empty-state">
            <h2>Aún no tienes gestiones asignadas</h2>
            <p>Cuando administración te asigne un rol, aquí verás tus tareas y avisos.</p>
        </div>
    {% endif %}
{% endblock %}
