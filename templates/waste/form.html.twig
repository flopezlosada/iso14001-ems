{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ record.id ? 'Editar retirada' : 'Nueva retirada' }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('waste_index') }}">Residuos</a><span class="sep">/</span>
    {{ record.id ? 'Editar' : 'Nueva' }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ record.id ? 'Editar retirada' : 'Nueva retirada' }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.lerCode, form.description, form.quantityKg, form.pickupDate, form.manager]) }}
            <div class="form-row">
                {{ form_widget(form.hazardous) }} {{ form_label(form.hazardous) }}
            </div>
            <div class="form-row">
                {{ form_label(form.notes) }}
                {{ form_widget(form.notes) }}
            </div>
            {{ f.actions(path('waste_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
