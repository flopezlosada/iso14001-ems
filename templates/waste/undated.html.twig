{% extends 'app_shell.html.twig' %}

{% block title %}Residuos sin fecha{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span><a href="{{ path('waste_index') }}">Residuos</a><span class="sep">/</span>Sin fecha{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::WASTE')) %}
    <div class="page-head">
        <div>
            <h1>Residuos sin fecha</h1>
            <p class="lead">Retiradas cuya fecha está en texto libre (un mes o un rango, anotado en las observaciones) y no se ha podido situar en un año. Edita cada una para asignarle una fecha y que aparezca en su año.</p>
        </div>
        <div>
            <a class="btn secondary" href="{{ path('waste_index') }}">← Volver a residuos</a>
        </div>
    </div>

    <div class="card">
        {% if records is empty %}
            <div class="empty-state">
                <h2>No hay retiradas sin fecha</h2>
                <p>Todas las retiradas tienen una fecha asignada y aparecen en su año.</p>
                <a class="btn" href="{{ path('waste_index') }}">Volver a residuos</a>
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr><th>LER</th><th>Residuo</th><th>Cantidad</th><th data-filter>Gestor</th><th data-filter>Peligroso</th><th>Observaciones</th><th></th></tr>
                </thead>
                <tbody>
                    {% for record in records %}
                        <tr>
                            <td class="mono muted">{{ record.lerCode ?? '—' }}</td>
                            <td>{{ record.description }}</td>
                            <td>{{ record.quantityKg ? record.quantityKg ~ ' kg' : '—' }}</td>
                            <td class="muted">{{ record.manager ?? '—' }}</td>
                            <td>{{ record.hazardous ? 'Sí' : 'No' }}</td>
                            <td class="muted">{{ record.notes ?? '—' }}</td>
                            <td>{% if can_write %}<a href="{{ path('waste_edit', { id: record.id }) }}">Editar</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
