{% extends 'app_shell.html.twig' %}

{% block title %}Residuos {{ year }}{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Residuos{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::WASTE')) %}
    <div class="page-head">
        <div>
            <h1>Residuos {{ year }}</h1>
            <p class="lead">Registro cronológico de retiradas de residuos.</p>
        </div>
        <div>
            <a class="btn secondary" href="{{ path('waste_trend') }}">Ver tendencia</a>
            {% if can_write %}<a class="btn" href="{{ path('waste_new') }}">+ Nueva retirada</a>{% endif %}
        </div>
    </div>

    <div class="toolbar">
        <span class="mono muted">
            <a class="btn secondary" href="{{ path('waste_year', { year: year - 1 }) }}">← {{ year - 1 }}</a>
            <a class="btn secondary" href="{{ path('waste_year', { year: year + 1 }) }}">{{ year + 1 }} →</a>
        </span>
        {% if undatedCount > 0 %}
            <a class="btn secondary" href="{{ path('waste_undated') }}">Sin fecha ({{ undatedCount }})</a>
        {% endif %}
    </div>

    <div class="card">
        {% if records is empty %}
            <div class="empty-state">
                <h2>Aún no hay retiradas en {{ year }}</h2>
                <p>Añade la primera retirada de residuos de este año.</p>
                {% if can_write %}<a class="btn" href="{{ path('waste_new') }}">Nueva retirada</a>{% endif %}
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr><th>Fecha</th><th>LER {{ help_button('residuo-ler') }}</th><th>Residuo</th><th>Cantidad</th><th data-filter>Gestor {{ help_button('residuo-gestor') }}</th><th data-filter>Peligroso</th><th></th></tr>
                </thead>
                <tbody>
                    {% for record in records %}
                        <tr>
                            <td>{{ record.pickupDate ? record.pickupDate|date('d/m/Y') : '—' }}</td>
                            <td class="mono muted">{{ record.lerCode ?? '—' }}</td>
                            <td>{{ record.description }}</td>
                            <td>{{ record.quantityKg ? record.quantityKg ~ ' kg' : '—' }}</td>
                            <td class="muted">{{ record.manager ?? '—' }}</td>
                            <td>{{ record.hazardous ? 'Sí' : 'No' }}</td>
                            <td>{% if can_write %}<a href="{{ path('waste_edit', { id: record.id }) }}">Editar</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
