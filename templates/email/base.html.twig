{#
   Shared branded layout for all outgoing e-mails (magic link + cron digests).
   Table-based with inline styles on purpose: e-mail clients strip <style>/external CSS and
   CSS custom properties, so the SGA palette (see public/css/app.css) is hard-coded here.
   Child templates fill {% block content %} and, optionally, {% block heading %}/{% block preheader %}.
#}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Sistema de Gestión Ambiental{% endblock %}</title>
</head>
<body style="margin:0; padding:0; background:#D9D8D1; -webkit-text-size-adjust:100%;">
    {# Preheader: the preview snippet shown in the inbox list, hidden in the body. #}
    <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; opacity:0;">{% block preheader %}{% endblock %}</div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#D9D8D1;">
        <tr>
            <td align="center" style="padding:24px 12px;">
                <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="width:640px; max-width:100%; background:#FFFFFF; border:1px solid #E4E6E0; border-radius:10px; overflow:hidden;">
                    {# Header / wordmark #}
                    <tr>
                        <td style="background:#E3E8DF; padding:20px 28px; border-bottom:1px solid #CDD2C8;">
                            <div style="font-family:Georgia,'Times New Roman',serif; font-size:20px; font-weight:bold; color:#20231E; letter-spacing:0.5px;">SGA</div>
                            <div style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:#5C6159; margin-top:3px;">Sistema de Gestión Ambiental · ISO 14001</div>
                        </td>
                    </tr>

                    {# Body #}
                    <tr>
                        <td style="padding:28px; font-family:Arial,Helvetica,sans-serif; color:#20231E; font-size:15px; line-height:1.55;">
                            {% block heading %}{% endblock %}
                            {% block content %}{% endblock %}
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td style="padding:18px 28px; background:#F4F6F2; border-top:1px solid #E4E6E0; font-family:Arial,Helvetica,sans-serif; font-size:12px; color:#8A8F86; line-height:1.5;">
                            Mensaje automático del Sistema de Gestión Ambiental (ISO 14001). No es necesario responder a este correo.
                        </td>
                    </tr>
                </table>
                <div style="font-family:Arial,Helvetica,sans-serif; font-size:11px; color:#8A8F86; margin-top:14px;">SGA · ISO 14001</div>
            </td>
        </tr>
    </table>
</body>
</html>
