{% extends 'email/base.html.twig' %}

{% block title %}Obligaciones pendientes · SGA{% endblock %}
{% block preheader %}{{ alerts|length }} obligación(es) del SGA con revisión pendiente a {{ today|date('d/m/Y') }}.{% endblock %}

{% block heading %}
    <h1 style="margin:0 0 16px; font-family:Georgia,'Times New Roman',serif; font-size:20px; font-weight:bold; color:#20231E;">Obligaciones pendientes</h1>
{% endblock %}

{% block content %}
    <p style="margin:0 0 14px;">Hola {{ user.fullName }},</p>
    <p style="margin:0 0 18px;">Estas obligaciones del Sistema de Gestión Ambiental (ISO 14001) tienen una revisión pendiente a fecha de <strong>{{ today|date('d/m/Y') }}</strong>:</p>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse; width:100%; border:1px solid #E4E6E0; border-radius:8px; overflow:hidden;">
        <thead>
            <tr style="background:#F4F6F2;">
                <th align="left" style="padding:10px 12px; font-family:Arial,Helvetica,sans-serif; font-size:12px; text-transform:uppercase; letter-spacing:0.4px; color:#5C6159; border-bottom:1px solid #E4E6E0;">Documento</th>
                <th align="left" style="padding:10px 12px; font-family:Arial,Helvetica,sans-serif; font-size:12px; text-transform:uppercase; letter-spacing:0.4px; color:#5C6159; border-bottom:1px solid #E4E6E0;">Revisión</th>
            </tr>
        </thead>
        <tbody>
            {% for alert in alerts %}
                {% set doc = alert.document %}
                {% set overdue = alert.nextDueDate < today %}
                <tr>
                    <td style="padding:12px; border-bottom:1px solid #EEF0EC; vertical-align:top;">
                        <strong style="color:#20231E;">{{ doc.code }}</strong> <span style="color:#5C6159;">— {{ doc.title }}</span>
                        {% if doc.instructions %}<div style="color:#8A8F86; font-size:13px; margin-top:4px;">{{ doc.instructions }}</div>{% endif %}
                    </td>
                    <td style="padding:12px; border-bottom:1px solid #EEF0EC; white-space:nowrap; vertical-align:top; color:{{ overdue ? '#B00020' : '#8A6D00' }}; font-weight:bold;">
                        {{ overdue ? 'Venció el' : 'Vence el' }} {{ alert.nextDueDate|date('d/m/Y') }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p style="margin:20px 0 0; color:#5C6159;">Entra en la aplicación del SGA para cumplimentarlas o marcarlas como hechas.</p>
{% endblock %}
