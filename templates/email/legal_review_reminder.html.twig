{% extends 'email/base.html.twig' %}

{% block title %}Revisión de requisitos legales · SGA{% endblock %}
{% block preheader %}{{ requirements|length }} requisito(s) legal(es) con revisión vencida o próxima a {{ today|date('d/m/Y') }}.{% endblock %}

{% block heading %}
    <h1 style="margin:0 0 16px; font-family:Georgia,'Times New Roman',serif; font-size:20px; font-weight:bold; color:#20231E;">Revisión de requisitos legales</h1>
{% endblock %}

{% block content %}
    <p style="margin:0 0 14px;">Hola {{ user.fullName }},</p>
    <p style="margin:0 0 18px;">Estos requisitos legales (ISO 14001, PC-06.03) tienen su revisión de cumplimiento vencida o próxima a fecha de <strong>{{ today|date('d/m/Y') }}</strong>. Conviene revisarlos y, en su caso, pasar la inspección correspondiente:</p>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse; width:100%; border:1px solid #E4E6E0; border-radius:8px; overflow:hidden;">
        <thead>
            <tr style="background:#F4F6F2;">
                <th align="left" style="padding:10px 12px; font-family:Arial,Helvetica,sans-serif; font-size:12px; text-transform:uppercase; letter-spacing:0.4px; color:#5C6159; border-bottom:1px solid #E4E6E0;">Ref.</th>
                <th align="left" style="padding:10px 12px; font-family:Arial,Helvetica,sans-serif; font-size:12px; text-transform:uppercase; letter-spacing:0.4px; color:#5C6159; border-bottom:1px solid #E4E6E0;">Disposición legal</th>
                <th align="left" style="padding:10px 12px; font-family:Arial,Helvetica,sans-serif; font-size:12px; text-transform:uppercase; letter-spacing:0.4px; color:#5C6159; border-bottom:1px solid #E4E6E0;">Próxima revisión</th>
                <th align="left" style="padding:10px 12px; font-family:Arial,Helvetica,sans-serif; font-size:12px; text-transform:uppercase; letter-spacing:0.4px; color:#5C6159; border-bottom:1px solid #E4E6E0;">Estado</th>
            </tr>
        </thead>
        <tbody>
            {% for requirement in requirements %}
                {% set overdue = requirement.isReviewOverdueOn(today) %}
                <tr>
                    <td style="padding:12px; border-bottom:1px solid #EEF0EC; white-space:nowrap; vertical-align:top;"><strong style="color:#20231E;">{{ requirement.reference }}</strong></td>
                    <td style="padding:12px; border-bottom:1px solid #EEF0EC; vertical-align:top; color:#5C6159;">{{ requirement.legalProvision }}</td>
                    <td style="padding:12px; border-bottom:1px solid #EEF0EC; white-space:nowrap; vertical-align:top;">{{ requirement.nextReviewOn|date('d/m/Y') }}</td>
                    <td style="padding:12px; border-bottom:1px solid #EEF0EC; white-space:nowrap; vertical-align:top; color:{{ overdue ? '#B00020' : '#8A6D00' }}; font-weight:bold;">
                        {{ overdue ? 'Vencida' : 'Próxima' }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p style="margin:20px 0 0; color:#5C6159;">Entra en la aplicación del SGA, en el módulo de requisitos legales, para registrar la revisión.</p>
{% endblock %}
