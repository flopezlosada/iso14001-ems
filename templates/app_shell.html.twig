{% extends 'base.html.twig' %}

{# Layout principal de la aplicación: barra lateral + cabecera + contenido.
   Las plantillas de pantalla extienden ESTE archivo y rellenan {% block body %}.
   El login y demás vistas sin sesión extienden 'base.html.twig' directamente. #}

{% set route = app.request.attributes.get('_route') %}

{% block shell %}
    <div class="layout">
        <aside class="sidebar">
            <div class="sidebar-head">
                <a class="brand" href="{{ path('app_homepage') }}">
                    <span class="brand-mark">{{ include('partials/_brand_mark.html.twig', { size: 30 }) }}</span>
                    <span class="brand-name">Gestión ambiental</span>
                </a>
                <button class="nav-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav">
                    <span class="nav-toggle-bars"></span>
                </button>
            </div>

            <nav id="main-nav" class="nav" aria-label="Navegación principal">
                {# El día a día: por aquí entra el trabajo, no por la lista de módulos. #}
                <a href="{{ path('app_homepage') }}" class="{{ route == 'app_homepage' ? 'is-active' }}">Inicio</a>
                <a href="{{ path('obligation_index') }}" class="{{ route starts with 'obligation_index' ? 'is-active' }}">Qué toca</a>
                <a href="{{ path('obligation_calendar') }}" class="{{ route starts with 'obligation_calendar' ? 'is-active' }}">Calendario</a>
                <a href="{{ path('obligation_structure') }}" class="{{ route starts with 'obligation_structure' ? 'is-active' }}">Estructura del SGA</a>
                <a href="{{ path('document_index') }}" class="{{ route starts with 'document_' ? 'is-active' }}">Documentos</a>

                {# Módulos agrupados por las carpetas PDCA del centro (Planificar/Implementación/Verificar/
                   Mejora). La lista la construye nav_pillars(): solo las áreas que el usuario puede leer
                   y solo los pilares con alguna área visible. Normalmente se llega a cada módulo desde su
                   obligación; esto es el acceso directo. #}
                {# Cada pilar es plegable (nav-pillars.js): solo se expande el del módulo actual, para que
                   quien ve muchas áreas no tenga una pared de enlaces. Sin JS quedan todos abiertos. #}
                {% for pillar in nav_pillars() %}
                    <div class="nav-pillar" data-nav-pillar>
                        <button type="button" class="nav-label" aria-controls="navgrp-{{ loop.index }}">{{ pillar.label }}</button>
                        <div class="nav-group" id="navgrp-{{ loop.index }}">
                            {% for item in pillar.items %}
                                <a href="{{ path(item.route) }}" class="{{ route starts with item.prefix ? 'is-active' }}">{{ item.label }}</a>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="nav-pillar" data-nav-pillar>
                        <button type="button" class="nav-label" aria-controls="navgrp-admin">Administración</button>
                        <div class="nav-group" id="navgrp-admin">
                            <a href="{{ path('audit_index') }}" class="{{ route starts with 'audit' ? 'is-active' }}">Registro de actividad</a>
                            <a href="{{ path('admin_user_index') }}" class="{{ route starts with 'admin_user' ? 'is-active' }}">Usuarios</a>
                            <a href="{{ path('admin_role_index') }}" class="{{ route starts with 'admin_role' ? 'is-active' }}">Roles y permisos</a>
                            <a href="{{ path('admin_settings_edit') }}" class="{{ route starts with 'admin_settings' ? 'is-active' }}">Ajustes</a>
                            <a href="{{ path('admin_operational_control_item_index') }}" class="{{ route starts with 'admin_operational_control_item' ? 'is-active' }}">Checklist control operacional</a>
                        </div>
                    </div>
                {% endif %}
            </nav>

            {# Fondo oscurecido del cajón móvil; al pulsarlo se cierra. Solo visible en móvil. #}
            <div class="nav-backdrop"></div>

            <div class="sidebar-foot">
                SGA · ISO 14001<br>
                Sistema de gestión ambiental
            </div>
        </aside>

        <div class="main">
            <header class="topbar">
                <nav class="breadcrumb" aria-label="Ruta">
                    {% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a>{% endblock %}
                </nav>
                <div class="topbar-right">
                    {# Salto rápido: buscador de módulos en cliente (public/js/quickjump.js). La lista
                       la genera el servidor reutilizando nav_pillars() + el bloque de Administración,
                       así que solo aparecen los módulos que el usuario puede leer (mismo criterio que
                       la barra lateral, sin duplicar el filtrado). Cada resultado es un <a href> real:
                       Ctrl/⌘+clic abre pestaña nueva sin perder el formulario en curso. Sin JS el panel
                       no se despliega; la barra lateral sigue siendo el camino completo. #}
                    {% if app.user %}
                        <div class="quickjump" data-quickjump>
                            <input type="search" class="quickjump__input" placeholder="Ir a un módulo…"
                                   role="combobox" aria-haspopup="listbox" aria-expanded="false"
                                   aria-controls="quickjump-list" aria-autocomplete="list"
                                   aria-label="Ir a un módulo" autocomplete="off">
                            {# Los resultados son <a role="option"> hijos directos del role="listbox" (sin
                               <li> intermedio): así el árbol de accesibilidad listbox→option es válido. El
                               rol no afecta a la navegación del navegador, los enlaces siguen siendo reales
                               (Ctrl/⌘+clic abre pestaña nueva). #}
                            <div class="quickjump__panel" hidden>
                                <div class="quickjump__list" id="quickjump-list" role="listbox" aria-label="Módulos">
                                    <a role="option" class="quickjump__item" href="{{ path('app_homepage') }}"><span class="quickjump__name">Inicio</span><span class="quickjump__hint">General</span></a>
                                    <a role="option" class="quickjump__item" href="{{ path('obligation_index') }}"><span class="quickjump__name">Qué toca</span><span class="quickjump__hint">General</span></a>
                                    <a role="option" class="quickjump__item" href="{{ path('obligation_structure') }}"><span class="quickjump__name">Estructura del SGA</span><span class="quickjump__hint">General</span></a>
                                    <a role="option" class="quickjump__item" href="{{ path('document_index') }}"><span class="quickjump__name">Documentos</span><span class="quickjump__hint">General</span></a>
                                    {% for pillar in nav_pillars() %}
                                        {% for item in pillar.items %}
                                            <a role="option" class="quickjump__item" href="{{ path(item.route) }}"><span class="quickjump__name">{{ item.label }}</span><span class="quickjump__hint">{{ pillar.label }}</span></a>
                                        {% endfor %}
                                    {% endfor %}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a role="option" class="quickjump__item" href="{{ path('audit_index') }}"><span class="quickjump__name">Registro de actividad</span><span class="quickjump__hint">Administración</span></a>
                                        <a role="option" class="quickjump__item" href="{{ path('admin_user_index') }}"><span class="quickjump__name">Usuarios</span><span class="quickjump__hint">Administración</span></a>
                                        <a role="option" class="quickjump__item" href="{{ path('admin_role_index') }}"><span class="quickjump__name">Roles y permisos</span><span class="quickjump__hint">Administración</span></a>
                                        <a role="option" class="quickjump__item" href="{{ path('admin_settings_edit') }}"><span class="quickjump__name">Ajustes</span><span class="quickjump__hint">Administración</span></a>
                                        <a role="option" class="quickjump__item" href="{{ path('admin_operational_control_item_index') }}"><span class="quickjump__name">Checklist control operacional</span><span class="quickjump__hint">Administración</span></a>
                                    {% endif %}
                                </div>
                                <p class="quickjump__empty" hidden>Sin resultados</p>
                            </div>
                        </div>
                    {% endif %}
                    <div class="theme-toggle" role="group" aria-label="Tema de color">
                        <button type="button" data-theme-value="light" aria-pressed="true">Claro</button>
                        <button type="button" data-theme-value="dark" aria-pressed="false">Oscuro</button>
                    </div>
                    {% if app.user %}
                        <span class="user">
                            <span class="avatar">{{ app.user.fullName|split(' ')|map(w => w|first)|join|slice(0, 2)|upper }}</span>
                            <span>{{ app.user.fullName }}</span>
                            <span aria-hidden="true">·</span>
                            <a href="{{ path('app_logout') }}">Salir</a>
                        </span>
                    {% endif %}
                </div>
            </header>

            <main class="page">
                {% for message in app.flashes('success') %}
                    <div class="flash success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="flash error">{{ message }}</div>
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}
