{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Nueva área' : 'Editar área' }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('risk_index') }}">Riesgos y oportunidades</a><span class="sep">/</span>
    <a href="{{ path('risk_area_index') }}">Procesos / Áreas</a><span class="sep">/</span>
    {{ isNew ? 'Nueva área' : area.name }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Nueva área' : 'Editar ' ~ area.name }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.name, form.active]) }}
            {{ f.actions(path('risk_area_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
