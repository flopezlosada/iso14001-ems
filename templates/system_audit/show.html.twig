{% extends 'app_shell.html.twig' %}

{% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::SYSTEM_AUDIT')) %}
{% set can_read_nc = is_granted('AREA_READ', constant('App\\Enum\\Area::NONCONFORMITY')) %}
{% set can_write_nc = is_granted('AREA_WRITE', constant('App\\Enum\\Area::NONCONFORMITY')) %}

{% block title %}Auditoría {{ audit.type.label|lower }} {{ audit.year }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('system_audit_index') }}">Auditorías</a><span class="sep">/</span>
    Auditoría {{ audit.type.label|lower }} {{ audit.year }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Auditoría {{ audit.type.label|lower }} {{ audit.year }} <span class="badge {{ audit.status.badgeClass }}">{{ audit.status.label }}</span> {{ help_button('auditoria-estado') }}</h1>
            <p class="lead">{{ audit.auditor }}{% if audit.conductedOn %} · {{ audit.conductedOn|date('d/m/Y') }}{% endif %}</p>
        </div>
        {% if can_write %}
            <div><a class="btn" href="{{ path('system_audit_edit', { id: audit.id }) }}">Editar</a></div>
        {% endif %}
    </div>

    <div class="card">
        <dl class="detail">
            <dt>Tipo</dt><dd>{{ audit.type.label }}</dd>
            <dt>Año</dt><dd>{{ audit.year }}</dd>
            <dt>Fecha de realización</dt><dd>{{ audit.conductedOn ? audit.conductedOn|date('d/m/Y') : '—' }}</dd>
            <dt>Auditor</dt><dd>{{ audit.auditor }}</dd>
            <dt>Objetivo</dt><dd>{{ audit.objective ? audit.objective|nl2br : '—' }}</dd>
            <dt>Alcance</dt><dd>{{ audit.scope ? audit.scope|nl2br : '—' }}</dd>
            <dt>Conclusiones</dt><dd>{{ audit.conclusions ? audit.conclusions|nl2br : '—' }}</dd>
            <dt>Informe</dt><dd>{% if audit.hasReport %}<a href="{{ path('system_audit_report', { id: audit.id }) }}">Descargar informe</a>{% else %}—{% endif %}</dd>
        </dl>
    </div>

    <div class="card" id="hallazgos">
        <div class="page-head">
            <h2>No conformidades de esta auditoría {{ help_button('no-conformidades') }}</h2>
            {% if can_write_nc %}
                <div>
                    <a class="btn secondary" href="{{ path('non_conformity_new', { audit: audit.id }) }}">+ Registrar no conformidad</a>
                    {% if findings is not empty %}
                        <form method="post" action="{{ path('system_audit_action_plan', { id: audit.id }) }}" data-confirm="¿Generar el borrador del plan de acciones para las no conformidades que aún no tienen ninguna?" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('action_plan_system_audit' ~ audit.id) }}">
                            <button type="submit" class="btn">Generar plan de acciones</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
        </div>
        {% if findings is empty %}
            <p class="muted">No hay no conformidades vinculadas a esta auditoría.{% if can_write_nc %} Registra las detectadas en el informe y después genera su plan de acciones.{% endif %}</p>
        {% else %}
            <table>
                <thead><tr><th>Referencia</th><th>Descripción</th><th>Estado</th><th>Plan de acciones</th></tr></thead>
                <tbody>
                    {% for nc in findings %}
                        <tr>
                            <td>
                                {% if can_read_nc %}
                                    <a href="{{ path('non_conformity_show', { id: nc.id }) }}">{{ nc.reference }}</a>
                                {% else %}
                                    {{ nc.reference }}
                                {% endif %}
                            </td>
                            <td>{{ nc.description }}</td>
                            <td><span class="badge {{ nc.status.badgeClass }}">{{ nc.status.label }}</span></td>
                            <td>
                                {%- set actionCount = nc.correctiveActions|length -%}
                                {{ actionCount > 0 ? actionCount ~ ' acción(es)' : 'Sin acciones' }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {{ include('partials/_activity_log.html.twig', { entries: activity }) }}
{% endblock %}
