{% extends 'app_shell.html.twig' %}

{% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::SYSTEM_AUDIT')) %}

{% block title %}Auditorías{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Auditorías{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Auditorías</h1>
            <p class="lead">Auditorías internas y externas del sistema de gestión ambiental (PC.09.0).</p>
        </div>
        {% if can_write %}
            <div><a class="btn" href="{{ path('system_audit_new') }}">+ Registrar auditoría</a></div>
        {% endif %}
    </div>

    {# Guía "qué falta este curso": pendientes de la auditoría interna del año (planificar →
       realizar → registrar hallazgos/NC → cerrar), cada paso enlazado a donde se resuelve. Los
       pasos se calculan en AuditWorkflowStatusProvider; aquí solo se traducen a la estructura del
       partial común. #}
    {% set steps = [] %}

    {# 1 · Planificar #}
    {% set steps = steps|merge([{
        state: status.planned ? 'is-done' : 'is-pending',
        label: 'Planificar la auditoría interna ' ~ status.year,
        hint: '§9.2',
        action: status.planned
            ? { type: 'link', style: 'plain', url: path('system_audit_show', { id: status.internalAuditId }), text: 'ver la auditoría' }
            : (can_write
                ? { type: 'link', url: path('system_audit_new', { type: 'internal' }), text: 'Crear auditoría interna ' ~ status.year }
                : { type: 'muted', text: 'Pendiente' })
    }]) %}

    {# 2 · Realizarla #}
    {% set steps = steps|merge([{
        state: not status.planned ? 'is-blocked' : (status.conducted ? 'is-done' : 'is-pending'),
        label: 'Realizarla',
        hint: 'fecha, auditor, informe',
        action: not status.planned
            ? { type: 'muted', text: 'Requiere planificar' }
            : (status.conducted
                ? { type: 'muted', text: 'Hecho' }
                : (can_write
                    ? { type: 'link', url: path('system_audit_edit', { id: status.internalAuditId }), text: 'Registrar realización' }
                    : { type: 'muted', text: 'Pendiente' }))
    }]) %}

    {# 3 · Registrar hallazgos y no conformidades #}
    {% set steps = steps|merge([{
        state: not status.conducted ? 'is-blocked' : (status.openFindings > 0 ? 'is-pending' : 'is-done'),
        label: 'Registrar hallazgos y no conformidades',
        note: status.conducted ? (status.findingsCount > 0 ? status.findingsCount ~ ' registrada(s)' : 'Sin no conformidades') : null,
        action: not status.conducted
            ? { type: 'muted', text: 'Requiere realizarla' }
            : (status.openFindings > 0
                ? { type: 'link', url: path('system_audit_show', { id: status.internalAuditId }) ~ '#hallazgos', text: status.openFindings ~ ' sin cerrar →' }
                : { type: 'link', style: 'plain', url: path('system_audit_show', { id: status.internalAuditId }) ~ '#hallazgos', text: 'revisar / registrar' })
    }]) %}

    {# 4 · Cerrar #}
    {% set steps = steps|merge([{
        state: not status.conducted ? 'is-blocked' : (status.closed ? 'is-done' : 'is-pending'),
        label: 'Cerrar la auditoría',
        hint: 'redactar conclusiones',
        action: not status.conducted
            ? { type: 'muted', text: 'Requiere realizarla' }
            : (status.closed
                ? { type: 'muted', text: 'Hecho' }
                : (can_write
                    ? { type: 'link', url: path('system_audit_edit', { id: status.internalAuditId }), text: 'Redactar conclusiones' }
                    : { type: 'muted', text: 'Pendiente' }))
    }]) %}

    {% include '_partials/_workflow_guide.html.twig' with { guide: {
        title: 'Auditoría interna de ' ~ status.year,
        subtitle: 'Qué hay que hacer aquí y qué te falta.',
        complete: status.isComplete,
        complete_label: 'Al día para ' ~ status.year,
        steps: steps,
    } } only %}

    <div class="card" id="listado">
        {% if audits is empty %}
            <div class="empty-state">
                <h2>Aún no hay auditorías registradas</h2>
                <p>Registra la primera auditoría interna o externa del sistema de gestión.</p>
                {% if can_write %}<a class="btn" href="{{ path('system_audit_new') }}">Registrar la primera</a>{% endif %}
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr><th data-filter="anio">Año</th><th data-filter="tipo">Tipo {{ help_button('auditoria-tipo') }}</th><th data-filter="estado">Estado {{ help_button('auditoria-estado') }}</th><th>Fecha</th><th>Auditor</th><th>Informe</th><th></th></tr>
                </thead>
                <tbody>
                    {% for audit in audits %}
                        <tr>
                            <td>{{ audit.year }}</td>
                            <td><a href="{{ path('system_audit_show', { id: audit.id }) }}">Auditoría {{ audit.type.label|lower }}</a></td>
                            <td><span class="badge {{ audit.status.badgeClass }}">{{ audit.status.label }}</span></td>
                            <td class="muted">{{ audit.conductedOn ? audit.conductedOn|date('d/m/Y') : '—' }}</td>
                            <td>{{ audit.auditor }}</td>
                            <td>
                                {% if audit.hasReport %}
                                    <a href="{{ path('system_audit_report', { id: audit.id }) }}">Descargar</a>
                                {% else %}
                                    <span class="muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('system_audit_show', { id: audit.id }) }}">Ver</a>
                                {% if can_write %}
                                    <a href="{{ path('system_audit_edit', { id: audit.id }) }}">Editar</a>
                                    <form method="post" action="{{ path('system_audit_delete', { id: audit.id }) }}" data-confirm="¿Eliminar la auditoría {{ audit.type.label|lower|e('html_attr') }} {{ audit.year }}? Sus no conformidades se conservan, solo se desvinculan." style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_system_audit' ~ audit.id) }}">
                                        <button type="submit" class="btn secondary">Eliminar</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
