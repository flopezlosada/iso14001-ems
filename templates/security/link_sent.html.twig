{% extends 'base.html.twig' %}

{% block title %}Revisa tu correo{% endblock %}

{% block body %}
    <h1>Revisa tu correo</h1>
    <div class="card">
        <p>Si <strong>{{ email }}</strong> corresponde a un usuario registrado, te hemos enviado un enlace para entrar. Es válido durante 10 minutos.</p>
        <a class="btn secondary" href="{{ path('login') }}">Volver</a>
    </div>
{% endblock %}
