{% extends 'app_shell.html.twig' %}
{% import 'legal_requirement/_macros.html.twig' as legal %}

{% block title %}{{ requirement.reference }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('legal_requirement_index') }}">Requisitos legales</a><span class="sep">/</span>
    {{ requirement.reference }}
{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::LEGAL_REQUIREMENT')) %}
    <div class="page-head">
        <div>
            <h1 class="mono">{{ requirement.reference }} <span class="badge {{ requirement.complianceStatus.badgeClass }}">{{ requirement.complianceStatus.label }}</span></h1>
            <p class="lead">{{ requirement.legalProvision }}</p>
        </div>
        <div class="page-actions">
            {% if requirement.nonCompliant %}
                <a class="btn" href="{{ path('non_conformity_new', { origin: 'internal', description: 'Incumplimiento del requisito legal ' ~ requirement.reference ~ ' (' ~ requirement.legalProvision ~ '): ' ~ requirement.specificRequirement }) }}">Abrir no conformidad</a>
            {% endif %}
            {% if can_write %}
                <a class="btn secondary" href="{{ path('legal_requirement_edit', { id: requirement.id }) }}">Editar requisito</a>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <dl class="detail-grid">
            <dt>Ámbito</dt><dd>{{ requirement.scope.label }}</dd>
            <dt>Vector ambiental {{ help_button('legal-vector') }}</dt><dd>{{ requirement.environmentalVector ?? '—' }}</dd>
            <dt>Evaluación del cumplimiento {{ help_button('legal-cumplimiento') }}</dt>
            <dd><span class="badge {{ requirement.complianceStatus.badgeClass }}">{{ requirement.complianceStatus.label }}</span></dd>
            <dt>Frecuencia de evaluación {{ help_button('legal-revision') }}</dt><dd>{{ requirement.evaluationFrequency ? requirement.evaluationFrequency.label : '—' }}</dd>
            <dt>Última revisión</dt><dd>{{ requirement.lastReviewedOn ? requirement.lastReviewedOn|date('d/m/Y') : '—' }}</dd>
            <dt>Próxima revisión</dt><dd>{{ legal.next_review(requirement, today) }}</dd>
            <dt>Última actualización</dt><dd>{{ requirement.updatedAt|date('d/m/Y') }}</dd>
        </dl>

        <h2>Requisito específico</h2>
        <p>{{ requirement.specificRequirement|nl2br }}</p>

        <h2>Evidencia de cumplimiento {{ help_button('legal-cumplimiento') }}</h2>
        <p>{{ requirement.complianceEvidence ? requirement.complianceEvidence|nl2br : '—' }}</p>
    </div>
{% endblock %}
