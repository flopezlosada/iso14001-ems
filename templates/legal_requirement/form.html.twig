{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Registrar' : 'Editar' }} requisito legal{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('legal_requirement_index') }}">Requisitos legales</a><span class="sep">/</span>
    {{ isNew ? 'Registrar' : requirement.reference }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Registrar requisito legal' : 'Editar ' ~ requirement.reference }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.section('El requisito', [form.legalProvision, form.scope, form.environmentalVector, form.specificRequirement]) }}
            {{ f.section('Cumplimiento', [form.complianceEvidence, form.complianceStatus]) }}
            {{ f.section('Revisión', [form.evaluationFrequency, form.lastReviewedOn, form.nextReviewOn]) }}
            {{ f.actions(path('legal_requirement_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
