{% extends 'app_shell.html.twig' %}

{% block title %}Roles{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Roles y permisos{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Roles y permisos</h1>
            <p class="lead">Cada rol define qué puede leer o escribir en cada área. Las personas heredan el acceso de sus roles.</p>
        </div>
        <a class="btn" href="{{ path('admin_role_new') }}">+ Nuevo rol</a>
    </div>

    <div class="card">
        {% if roles is empty %}
            <div class="empty-state">
                <h2>No hay roles todavía</h2>
                <p>Crea el primer rol y define sus permisos por área.</p>
                <a class="btn" href="{{ path('admin_role_new') }}">Nuevo rol</a>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Nombre</th><th>Código</th>
                        {% for area in areas %}<th>{{ area.label }}</th>{% endfor %}
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for role in roles %}
                        <tr>
                            <td>{{ role.name }}</td>
                            <td class="mono muted">{{ role.code }}</td>
                            {% if role.isAdmin %}
                                {# Un rol admin ignora la matriz: mostrar su acceso real, no columnas de "Sin acceso". #}
                                <td colspan="{{ areas|length }}"><span class="badge badge--success">Acceso total (administrador)</span></td>
                            {% else %}
                                {% for area in areas %}<td class="muted">{{ role.getLevel(area).label }}</td>{% endfor %}
                            {% endif %}
                            <td><a href="{{ path('admin_role_edit', { id: role.id }) }}">Editar</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
