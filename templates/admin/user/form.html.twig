{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ user.id ? 'Editar usuario' : 'Nuevo usuario' }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('admin_user_index') }}">Usuarios</a><span class="sep">/</span>
    {{ user.id ? 'Editar' : 'Nuevo' }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ user.id ? 'Editar usuario' : 'Nuevo usuario' }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            <div class="form-row">
                {{ form_label(form.fullName) }}
                {{ form_widget(form.fullName) }}
                {{ form_errors(form.fullName) }}
            </div>
            <div class="form-row">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {% if form.email.vars.help %}<p class="help">{{ form.email.vars.help }}</p>{% endif %}
                {{ form_errors(form.email) }}
            </div>
            <div class="form-row">
                {{ form_widget(form.active) }} {{ form_label(form.active) }}
            </div>
            <div class="form-row">
                {{ form_label(form.assignedRoles) }}
                {{ form_widget(form.assignedRoles) }}
                {{ form_errors(form.assignedRoles) }}
            </div>
            {{ f.actions(path('admin_user_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
