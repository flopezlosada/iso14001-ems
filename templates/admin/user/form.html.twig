{% extends 'base.html.twig' %}

{% block title %}{{ user.id ? 'Editar usuario' : 'Nuevo usuario' }}{% endblock %}

{% block body %}
    <h1>{{ user.id ? 'Editar usuario' : 'Nuevo usuario' }}</h1>

    <div class="card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            <div class="form-row">
                {{ form_label(form.fullName) }}
                {{ form_widget(form.fullName) }}
                {{ form_errors(form.fullName) }}
            </div>
            <div class="form-row">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {% if form.email.vars.help %}<p class="help">{{ form.email.vars.help }}</p>{% endif %}
                {{ form_errors(form.email) }}
            </div>
            <div class="form-row">
                {{ form_widget(form.active) }} {{ form_label(form.active) }}
            </div>
            <div class="form-row">
                {{ form_label(form.assignedRoles) }}
                {{ form_widget(form.assignedRoles) }}
                {{ form_errors(form.assignedRoles) }}
            </div>
            <button class="btn" type="submit">Guardar</button>
            <a class="btn secondary" href="{{ path('admin_user_index') }}">Cancelar</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
