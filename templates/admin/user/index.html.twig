{% extends 'base.html.twig' %}

{% block title %}Usuarios{% endblock %}

{% block body %}
    <div class="toolbar">
        <h1>Usuarios</h1>
        <a class="btn" href="{{ path('admin_user_new') }}">+ Nuevo usuario</a>
    </div>

    <div class="card">
        {% if users is empty %}
            <p class="muted">No hay usuarios todavía.</p>
        {% else %}
            <table>
                <thead>
                    <tr><th>Nombre</th><th>Correo</th><th>Activo</th><th>Roles</th><th></th></tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.fullName }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.active ? 'Sí' : 'No' }}</td>
                            <td class="muted">
                                {%- for role in user.assignedRoles -%}
                                    {{ role.name }}{% if not loop.last %}, {% endif %}
                                {%- else -%}—{%- endfor -%}
                            </td>
                            <td><a href="{{ path('admin_user_edit', { id: user.id }) }}">Editar</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
