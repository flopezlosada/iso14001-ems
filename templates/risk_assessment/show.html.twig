{% extends 'app_shell.html.twig' %}

{% block title %}Valoración {{ assessment.exercise }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('risk_index') }}">Riesgos y oportunidades</a><span class="sep">/</span>
    {{ assessment.exercise }}
{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::RISK_OPPORTUNITY')) %}
    {% set val_class = { 'critical': 'val--critical', 'moderate': 'val--moderate', 'trivial': 'val--trivial' } %}

    <div class="page-head">
        <div>
            <p class="eyebrow">{{ item.type.label }} · {{ item.processArea.name }} · curso {{ assessment.exercise }}</p>
            <h1>{{ item.description }}</h1>
        </div>
        <div>
            <a class="btn secondary" href="{{ path('risk_show', { id: item.id }) }}">Ver histórico de cursos</a>
            {% if can_write %}<a class="btn secondary" href="{{ path('risk_assessment_edit', { id: item.id, assessmentId: assessment.id }) }}">Editar</a>{% endif %}
        </div>
    </div>

    <div class="card">
        <dl class="detail-grid">
            <dt>Curso</dt><dd>{{ assessment.exercise }}</dd>
            <dt>Probabilidad</dt><dd class="mono">{{ assessment.probability.value }}</dd>
            <dt>Impacto</dt><dd class="mono">{{ assessment.impact.value }}</dd>
            <dt>Valoración (P×I)</dt>
            <dd>
                {% if assessment.category %}
                    <span class="{{ val_class[assessment.category.value] }}">{{ assessment.category.label(item.type) }}</span>
                    <span class="muted"> · {{ assessment.score }}</span>
                {% else %}
                    <span class="muted">—</span>
                {% endif %}
            </dd>
            <dt>Revisión</dt><dd>Rev. {{ assessment.revisionNumber }}</dd>
        </dl>
        {% if assessment.justification %}
            <h2>Justificación</h2>
            <p>{{ assessment.justification|nl2br }}</p>
        {% endif %}
    </div>

    <div class="page-head"><div><h2>Aprobación</h2></div></div>
    <div class="card">
        {% if assessment.approvedBy %}
            <p>Aprobada por <strong>{{ assessment.approvedBy.fullName }}</strong> <span class="muted">· {{ assessment.approvedAt|date('d/m/Y') }}</span></p>
        {% else %}
            <p class="muted">Esta valoración aún no está aprobada por Dirección.</p>
            {% if is_granted('RISK_ASSESSMENT_APPROVE', assessment) %}
                <form method="post" action="{{ path('risk_assessment_approve', { id: item.id, assessmentId: assessment.id }) }}" class="inline-form" data-confirm="¿Aprobar esta valoración del {{ item.type.label|lower|e('html_attr') }} para el curso {{ assessment.exercise }}? Quedará firmada por ti.">
                    <input type="hidden" name="_token" value="{{ csrf_token('risk_assessment_approve' ~ assessment.id) }}">
                    <button class="btn" type="submit">Aprobar</button>
                </form>
            {% endif %}
        {% endif %}
    </div>

    <div class="page-head" id="plan">
        <div><h2>Plan de acción</h2></div>
        {% if can_write %}<a class="btn secondary" href="{{ path('risk_assessment_edit', { id: item.id, assessmentId: assessment.id }) }}">Editar el plan</a>{% endif %}
    </div>
    <div class="card">
        {% if assessment.actions is empty %}
            {% if assessment.category and assessment.category.requiresActionPlan %}
                <p class="muted">Esta valoración es relevante ({{ assessment.category.label(item.type)|lower }}) y todavía no tiene plan de acción.</p>
            {% else %}
                <p class="muted">Sin plan de acción. Por su categoría no es obligatorio.</p>
            {% endif %}
        {% else %}
            <table>
                <thead>
                    <tr><th>Acción</th><th>Responsable</th><th>Plazo</th><th>Eficacia</th><th>Evaluada</th></tr>
                </thead>
                <tbody>
                    {% for action in assessment.actions %}
                        <tr>
                            <td>{{ action.description }}</td>
                            <td class="muted">{{ action.responsible ? action.responsible.name : '—' }}</td>
                            <td class="muted">{{ action.deadline ?? '—' }}</td>
                            <td class="muted">{{ action.efficacy ?? '—' }}</td>
                            <td class="muted">{{ action.evaluatedAt ? action.evaluatedAt|date('d/m/Y') : '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
