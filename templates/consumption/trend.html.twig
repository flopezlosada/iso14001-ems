{% extends 'app_shell.html.twig' %}

{% block title %}Tendencia de consumos{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('consumption_index') }}">Consumos</a><span class="sep">/</span>
    Tendencia
{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Tendencia de consumos</h1>
            <p class="lead">Evolución del total anual de cada consumo. Vista exploratoria; no afecta a la evaluación ni a los avisos.</p>
        </div>
    </div>

    {# Minimal CSS bar chart (no JS). The frontend can replace it with a real chart using this same data. #}
    <p class="help">Años mostrados:
        {% for n in [3, 5, 10] %}
            {%- if n == years %}<strong>{{ n }}</strong>{% else %}<a href="{{ path('consumption_trend', { years: n }) }}">{{ n }}</a>{% endif -%}
            {%- if not loop.last %} · {% endif -%}
        {% endfor %}
    </p>

    {% if series is empty %}
        <div class="card"><p class="help">Aún no hay consumos registrados con los que dibujar la tendencia.</p></div>
    {% else %}
        {% for s in series %}
            <div class="card" style="margin-bottom: 1rem;">
                <h2>{{ s.type.label }} <span class="muted">({{ s.type.unit }})</span></h2>
                <div style="display: flex; align-items: flex-end; gap: 16px; height: 180px; padding-top: 8px;">
                    {% for p in s.points %}
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%;">
                            <span style="font-size: 12px;">{{ p.value|round }}</span>
                            <div title="{{ p.year }}: {{ p.value|round }} {{ s.type.unit }}" style="width: 40px; height: {{ p.percent }}%; min-height: 2px; background: var(--accent, #2e7d32); border-radius: 4px 4px 0 0;"></div>
                            <span style="font-size: 12px; margin-top: 4px;">{{ p.year }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}
