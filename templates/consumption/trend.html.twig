{% extends 'app_shell.html.twig' %}

{% block title %}Tendencia de consumos{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('consumption_index') }}">Consumos</a><span class="sep">/</span>
    Tendencia
{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Tendencia de consumos</h1>
            <p class="lead">Evolución del total anual de cada consumo. Vista exploratoria; no afecta a la evaluación ni a los avisos.</p>
        </div>
    </div>

    {{ include('_trend_chart.html.twig', {
        series: series,
        years: years,
        trend_route: 'consumption_trend',
        empty_message: 'Aún no hay consumos registrados con los que dibujar la tendencia.',
    }) }}
{% endblock %}
