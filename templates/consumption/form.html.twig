{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ reading.id ? 'Editar' : 'Nueva' }} lectura · {{ year }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('consumption_year', { year: year }) }}">Consumos {{ year }}</a><span class="sep">/</span>
    {{ reading.id ? 'Editar' : 'Nueva' }} lectura
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ reading.id ? 'Editar lectura' : 'Nueva lectura' }} · {{ year }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.type, form.periodMonth, form.quantity, form.cost, form.notes, form.invoiceFile]) }}
            {% if reading.hasInvoice %}
                <p class="help">
                    Factura actual:
                    <a href="{{ path('consumption_invoice', { year: year, id: reading.id }) }}">{{ reading.invoiceOriginalName }}</a>.
                    Si subes otra, la reemplaza.
                </p>
            {% endif %}
            {{ f.actions(path('consumption_year', { year: year })) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
