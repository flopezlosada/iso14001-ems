{% extends 'app_shell.html.twig' %}

{% block title %}{{ reading.id ? 'Editar' : 'Nueva' }} lectura · {{ year }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('consumption_year', { year: year }) }}">Consumos {{ year }}</a><span class="sep">/</span>
    {{ reading.id ? 'Editar' : 'Nueva' }} lectura
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ reading.id ? 'Editar lectura' : 'Nueva lectura' }} · {{ year }}</h1>
    </div>

    <div class="card" style="max-width: 520px;">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {% for field in [form.type, form.periodMonth, form.quantity, form.cost, form.notes] %}
                <div class="form-row">
                    {{ form_label(field) }}
                    {{ form_widget(field) }}
                    {% if field.vars.help %}<p class="help">{{ field.vars.help }}</p>{% endif %}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
            <button class="btn" type="submit">Guardar</button>
            <a class="btn secondary" href="{{ path('consumption_year', { year: year }) }}">Cancelar</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
