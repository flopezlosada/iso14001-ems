{% extends 'app_shell.html.twig' %}

{% set month_names = ['', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'] %}

{% block title %}Consumos {{ year }}{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Registro de consumo{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Consumos {{ year }}</h1>
            <p class="lead">Lecturas de agua, electricidad y demás consumos del centro, registradas mes a mes.</p>
        </div>
        <div>
            <a class="btn secondary" href="{{ path('consumption_trend') }}">Ver tendencia</a>
            <a class="btn" href="{{ path('consumption_new', { year: year }) }}">+ Añadir lectura</a>
        </div>
    </div>

    <div class="toolbar">
        <span class="mono muted">
            <a class="btn secondary" href="{{ path('consumption_year', { year: year - 1 }) }}">← {{ year - 1 }}</a>
            <a class="btn secondary" href="{{ path('consumption_year', { year: year + 1 }) }}">{{ year + 1 }} →</a>
        </span>
    </div>

    <div class="card">
        {% if readings is empty %}
            <div class="empty-state">
                <h2>Aún no hay lecturas en {{ year }}</h2>
                <p>Empieza registrando la primera lectura del contador.</p>
                <a class="btn" href="{{ path('consumption_new', { year: year }) }}">Registrar primera lectura</a>
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr>
                        <th>Mes</th><th data-filter>Tipo</th><th>Cantidad</th><th>Coste</th><th>Observaciones</th><th data-nosort>Factura</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for reading in readings %}
                        <tr>
                            <td data-sort="{{ reading.periodMonth }}">{{ month_names[reading.periodMonth] }}</td>
                            <td>{{ reading.type.label }}</td>
                            <td class="mono">{{ reading.quantity }} {{ reading.type.unit }}</td>
                            <td class="mono">{{ reading.cost is null ? '—' : reading.cost ~ ' €' }}</td>
                            <td class="muted">{{ reading.notes ?? '' }}</td>
                            <td>{% if reading.hasInvoice %}<a href="{{ path('consumption_invoice', { year: year, id: reading.id }) }}">Ver</a>{% else %}—{% endif %}</td>
                            <td><a href="{{ path('consumption_edit', { year: year, id: reading.id }) }}">Editar</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
