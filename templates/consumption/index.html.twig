{% extends 'app_shell.html.twig' %}

{% set month_names = ['', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'] %}
{% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::CONSUMPTION')) %}

{# A recorded value: a link to its reading's edit form for writers, plain text for readers; plus,
   on the quantity cell, a marker showing the reading's observation as a tooltip and a link to the
   invoice when one is attached (readers can download it too). #}
{% macro value_cell(value, url, tint, note = null, invoice_url = null) %}<td class="num mono {{ tint }}">{% if note %}<span class="cell-note" tabindex="0" data-note="{{ note }}" aria-label="Observación: {{ note }}">i</span> {% endif %}{% if url %}<a class="cell-link" href="{{ url }}">{{ value }}</a>{% else %}{{ value }}{% endif %}{% if invoice_url %} <a class="cell-invoice" href="{{ invoice_url }}" title="Ver factura" aria-label="Ver factura">F</a>{% endif %}</td>{% endmacro %}

{% block title %}Consumos {{ year }}{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Registro de consumo{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Consumos {{ year }}</h1>
            <p class="lead">Registro mensual de consumos del centro (F-6.1.2).{% if can_write %} Pulsa una cifra para editarla o «+» para registrar ese mes.{% endif %}</p>
        </div>
        <div>
            <a class="btn secondary" href="{{ path('consumption_trend') }}">Ver tendencia</a>
            {% if can_write %}<a class="btn" href="{{ path('consumption_new', { year: year }) }}">+ Añadir lectura</a>{% endif %}
        </div>
    </div>

    <div class="toolbar">
        <span class="mono muted">
            <a class="btn secondary" href="{{ path('consumption_year', { year: year - 1 }) }}">← {{ year - 1 }}</a>
            <a class="btn secondary" href="{{ path('consumption_year', { year: year + 1 }) }}">{{ year + 1 }} →</a>
        </span>
    </div>

    <div class="card consumption-matrix">
        <table>
            <thead>
                <tr>
                    <th>Mes</th>
                    {% for type in types %}
                        {% set tint = 'tinted t-' ~ type.value %}
                        <th class="num {{ tint }}">{{ type.label }} ({{ type.unit }})</th>
                        {% if type.tracksCost %}<th class="num {{ tint }} is-cost">{{ type.label }} (€)</th>{% endif %}
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for month in 1..12 %}
                    <tr>
                        <td>{{ month_names[month] }}</td>
                        {% for type in types %}
                            {% set reading = matrix.reading(month, type) %}
                            {% set tint = 'tinted t-' ~ type.value %}
                            {% if reading %}
                                {% set edit_url = can_write ? path('consumption_edit', { year: year, id: reading.id }) : null %}
                                {{ _self.value_cell(reading.quantity|decimal, edit_url, tint, (reading.notes ?? "")|trim, reading.hasInvoice ? path('consumption_invoice', { year: year, id: reading.id }) : null) }}
                                {% if type.tracksCost %}{{ _self.value_cell(reading.cost ?? '', reading.cost is null ? null : edit_url, tint ~ ' is-cost') }}{% endif %}
                            {% else %}
                                <td class="num {{ tint }}">{% if can_write %}<a class="cell-add" href="{{ path('consumption_new', { year: year, type: type.value, month: month }) }}" aria-label="Registrar {{ type.label }} de {{ month_names[month]|lower }}">+</a>{% endif %}</td>
                                {% if type.tracksCost %}<td class="num {{ tint }} is-cost"></td>{% endif %}
                            {% endif %}
                        {% endfor %}
                    </tr>
                {% endfor %}
                <tr class="is-total">
                    <td>Total {{ year }}</td>
                    {% for type in types %}
                        {% set total = matrix.total(type) %}
                        {% set tint = 'tinted t-' ~ type.value %}
                        <td class="num mono {{ tint }}">{{ total ? total.quantity|decimal ~ ' ' ~ type.unit : '—' }}</td>
                        {% if type.tracksCost %}<td class="num mono {{ tint }} is-cost">{{ total and total.cost is not null ? total.cost ~ ' €' : '—' }}</td>{% endif %}
                    {% endfor %}
                </tr>
            </tbody>
        </table>
    </div>
{% endblock %}
