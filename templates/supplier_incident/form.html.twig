{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Nueva incidencia' : 'Editar incidencia' }} · {{ supplier.name }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('supplier_index') }}">Proveedores</a><span class="sep">/</span>
    <a href="{{ path('supplier_show', { id: supplier.id }) }}">{{ supplier.name }}</a><span class="sep">/</span>
    {{ isNew ? 'Nueva incidencia' : 'Editar incidencia' }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Nueva incidencia' : 'Editar incidencia' }} · {{ supplier.name }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.occurredOn, form.description, form.resolution, form.severe]) }}
            {{ f.actions(path('supplier_show', { id: supplier.id })) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
