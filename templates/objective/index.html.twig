{% extends 'app_shell.html.twig' %}
{% import _self as ui %}

{% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::OBJECTIVE')) %}

{# Botón que copia los objetivos del curso anterior (solo trae los que falten). #}
{% macro copy_previous_form(schoolYear, previousSchoolYear) %}
    <form method="post" action="{{ path('objective_copy_previous', { schoolYear: schoolYear }) }}" style="display:inline" data-confirm="¿Copiar a {{ schoolYear|e('html_attr') }} los objetivos de {{ previousSchoolYear|e('html_attr') }} que aún no existan?">
        <input type="hidden" name="_token" value="{{ csrf_token('copy_previous_objective' ~ schoolYear) }}">
        <button type="submit" class="btn secondary">Copiar de {{ previousSchoolYear }}</button>
    </form>
{% endmacro %}

{% block title %}Objetivos {{ schoolYear }}{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Objetivos{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Objetivos {{ schoolYear }}</h1>
            <p class="lead">Objetivos ambientales del curso y su cumplimiento (PG-06.04 / F.07.01).</p>
        </div>
        {% if can_write %}
            <div>
                <a class="btn" href="{{ path('objective_new', { schoolYear: schoolYear }) }}">+ Registrar objetivo</a>
                {% if previousYearCount > 0 and objectives is not empty %}{{ ui.copy_previous_form(schoolYear, previousSchoolYear) }}{% endif %}
            </div>
        {% endif %}
    </div>

    <div class="toolbar">
        <span class="mono muted">
            <a class="btn secondary" href="{{ path('objective_year', { schoolYear: previousSchoolYear }) }}">← {{ previousSchoolYear }}</a>
            <a class="btn secondary" href="{{ path('objective_year', { schoolYear: nextSchoolYear }) }}">{{ nextSchoolYear }} →</a>
        </span>
    </div>

    <div class="card">
        {% if objectives is empty %}
            <div class="empty-state">
                <h2>Aún no hay objetivos en {{ schoolYear }}</h2>
                {% if previousYearCount > 0 %}
                    <p>Puedes copiar los de {{ previousSchoolYear }} como punto de partida y revisarlos, o empezar de cero.</p>
                {% else %}
                    <p>Registra el primer objetivo del curso (normalmente a partir de los aspectos significativos).</p>
                {% endif %}
                {% if can_write %}
                    {% if previousYearCount > 0 %}{{ ui.copy_previous_form(schoolYear, previousSchoolYear) }}{% endif %}
                    <a class="btn" href="{{ path('objective_new', { schoolYear: schoolYear }) }}">Registrar el primero</a>
                {% endif %}
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr>
                        <th>Ref.</th><th>Objetivo</th><th data-filter>Responsable</th><th data-filter>Aspecto {{ help_button('objetivo-aspecto') }}</th><th>Periodo</th><th>Cumplimiento {{ help_button('objetivo-cumplimiento') }}</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for objective in objectives %}
                        <tr>
                            <td class="mono">{{ objective.reference }}</td>
                            <td>{{ objective.description|length > 70 ? objective.description|slice(0, 70) ~ '…' : objective.description }}</td>
                            <td>{{ objective.responsible ? objective.responsible.fullName : '—' }}</td>
                            <td class="muted">{{ objective.relatedAspect ? objective.relatedAspect.name : '—' }}</td>
                            <td class="muted">{{ objective.targetPeriod ?? '—' }}</td>
                            <td>
                                {{ objective.status.label }}
                                {%- if objective.notAchieved %} ·
                                    <a href="{{ path('non_conformity_new', { origin: 'internal', description: 'Objetivo no cumplido ' ~ objective.reference ~ ': ' ~ objective.description }) }}">Abrir NC</a>
                                {%- endif -%}
                            </td>
                            <td>{% if can_write %}<a href="{{ path('objective_edit', { schoolYear: schoolYear, id: objective.id }) }}">Editar</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
