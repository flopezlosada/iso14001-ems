{% extends 'app_shell.html.twig' %}

{% block title %}{{ objective.reference }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('objective_year', { schoolYear: schoolYear }) }}">Objetivos {{ schoolYear }}</a><span class="sep">/</span>
    {{ objective.reference }}
{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::OBJECTIVE')) %}
    <div class="page-head">
        <div>
            <h1 class="mono">{{ objective.reference }} <span class="badge {{ objective.status.badgeClass }}">{{ objective.status.label }}</span> {{ help_button('objetivo-cumplimiento') }}</h1>
            <p class="lead">Objetivo ambiental del curso {{ objective.schoolYear }} (F.07.01){% if objective.targetPeriod %} · {{ objective.targetPeriod }}{% endif %}</p>
        </div>
        <div class="page-actions">
            {% if objective.notAchieved %}
                <a class="btn secondary" href="{{ path('non_conformity_new', { origin: 'internal', description: 'Objetivo no cumplido ' ~ objective.reference ~ ': ' ~ objective.description }) }}">Abrir NC</a>
            {% endif %}
            {% if can_write %}
                <a class="btn secondary" href="{{ path('objective_edit', { schoolYear: schoolYear, id: objective.id }) }}">Editar objetivo</a>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <dl class="detail-grid">
            <dt>Curso</dt><dd class="mono">{{ objective.schoolYear }}</dd>
            <dt>Responsable</dt><dd>{{ objective.responsible ? objective.responsible.fullName : '—' }}</dd>
            <dt>Aspecto relacionado {{ help_button('objetivo-aspecto') }}</dt>
            <dd>
                {%- if objective.relatedAspect -%}
                    <a href="{{ path('aspect_show', { id: objective.relatedAspect.id }) }}">{{ objective.relatedAspect.name }}</a>
                {%- else -%}—{%- endif -%}
            </dd>
            <dt>Periodo objetivo</dt><dd>{{ objective.targetPeriod ?? '—' }}</dd>
            <dt>Última revisión</dt><dd>{{ objective.lastReviewedOn ? objective.lastReviewedOn|date('d/m/Y') : '—' }}</dd>
        </dl>
        <h2>Descripción y meta</h2>
        <p>{{ objective.description|nl2br }}</p>
        <h2>Notas de seguimiento</h2>
        <p>{{ objective.notes ? objective.notes|nl2br : '—' }}</p>
    </div>

    {{ include('partials/_activity_log.html.twig', { entries: activity }) }}
{% endblock %}
