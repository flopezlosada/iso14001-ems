{% extends 'app_shell.html.twig' %}

{% block title %}{{ drill.id ? 'Editar' : 'Nuevo' }} simulacro{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('emergency_drill_index') }}">Simulacros</a><span class="sep">/</span>
    {{ drill.id ? 'Editar' : 'Nuevo' }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ drill.id ? 'Editar informe de simulacro' : 'Nuevo informe de simulacro' }}</h1>
    </div>

    <div class="card" style="max-width: 560px;">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {% for field in [form.drillDate, form.emergencyType, form.location, form.participants, form.actionProcedure, form.conclusions, form.reportedBy] %}
                <div class="form-row">
                    {{ form_label(field) }}
                    {{ form_widget(field) }}
                    {% if field.vars.help %}<p class="help">{{ field.vars.help }}</p>{% endif %}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
            <button class="btn" type="submit">Guardar</button>
            <a class="btn secondary" href="{{ path('emergency_drill_index') }}">Cancelar</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
