{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ drill.id ? 'Editar' : 'Nuevo' }} simulacro{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('emergency_drill_index') }}">Simulacros</a><span class="sep">/</span>
    {{ drill.id ? 'Editar' : 'Nuevo' }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ drill.id ? 'Editar informe de simulacro' : 'Nuevo informe de simulacro' }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.drillDate, form.emergencyType, form.location, form.participants, form.actionProcedure, form.conclusions, form.reportedBy]) }}
            {{ f.actions(path('emergency_drill_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
