{% extends 'app_shell.html.twig' %}

{% block title %}Simulacros{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Simulacros{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::EMERGENCY')) %}
    <div class="page-head">
        <div>
            <h1>Simulacros</h1>
            <p class="lead">Informes de simulacros de emergencia del centro (incendio, derrames, evacuación).</p>
        </div>
        {% if can_write %}<a class="btn" href="{{ path('emergency_drill_new') }}">+ Nuevo simulacro</a>{% endif %}
    </div>

    <div class="card">
        {% if drills is empty %}
            <div class="empty-state">
                <h2>Sin simulacros todavía</h2>
                <p>Añade el primer informe de simulacro.</p>
                {% if can_write %}<a class="btn" href="{{ path('emergency_drill_new') }}">Nuevo simulacro</a>{% endif %}
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr><th>Fecha</th><th data-filter>Tipo de emergencia</th><th>Lugar</th><th>Realizado por</th><th></th></tr>
                </thead>
                <tbody>
                    {% for drill in drills %}
                        <tr>
                            <td>{{ drill.drillDate|date('d/m/Y') }}</td>
                            <td>{{ drill.emergencyType }}</td>
                            <td class="muted">{{ drill.location }}</td>
                            <td class="muted">{{ drill.reportedBy ?? '—' }}</td>
                            <td>{% if can_write %}<a href="{{ path('emergency_drill_edit', { id: drill.id }) }}">Editar</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
