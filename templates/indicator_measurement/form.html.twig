{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Nueva medición' : 'Editar medición' }} · {{ indicator.name }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('indicator_index') }}">Indicadores</a><span class="sep">/</span>
    <a href="{{ path('indicator_show', { id: indicator.id }) }}">{{ indicator.name }}</a><span class="sep">/</span>
    {{ isNew ? 'Nueva medición' : 'Editar medición' }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Nueva medición' : 'Editar medición' }} · {{ indicator.name }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.year, form.month, form.value, form.breached, form.notes]) }}
            {{ f.actions(path('indicator_show', { id: indicator.id })) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
