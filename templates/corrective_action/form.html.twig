{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Nueva acción correctiva' : 'Editar ' ~ action.reference }} · {{ nonConformity.reference }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('non_conformity_index') }}">No conformidades</a><span class="sep">/</span>
    <a href="{{ path('non_conformity_show', { id: nonConformity.id }) }}">{{ nonConformity.reference }}</a><span class="sep">/</span>
    {{ isNew ? 'Nueva acción' : action.reference }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Nueva acción correctiva' : 'Editar ' ~ action.reference }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.section('Acción', [form.description, form.responsible, form.plannedDate, form.implementationEvidence]) }}
            {{ f.section('Autorización', [form.requiresDirectionAuthorization]) }}
            {# La autorización y la eficacia se registran con los CTAs de la ficha, no aquí. #}
            {{ f.actions(path('non_conformity_show', { id: nonConformity.id })) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
