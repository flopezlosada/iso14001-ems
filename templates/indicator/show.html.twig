{% extends 'app_shell.html.twig' %}

{% set month_names = ['', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'] %}

{% block title %}{{ indicator.name }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('indicator_index') }}">Indicadores</a><span class="sep">/</span>
    {{ indicator.name }}
{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::INDICATOR')) %}
    {% set status = indicator.statusForYear(currentYear) %}
    <div class="page-head">
        <div>
            <h1>{{ indicator.name }} <span class="badge {{ status.badgeClass }}">{{ status.label }} {{ currentYear }}</span> {{ help_button('indicador-estado') }}</h1>
            <p class="lead">{{ indicator.process.label }} · {{ indicator.periodicity.label }}{% if indicator.referenceValue %} · ref. {{ indicator.referenceValue }}{% endif %}{% if not indicator.active %} · <span class="muted">inactivo</span>{% endif %}</p>
        </div>
        {% if can_write %}<a class="btn secondary" href="{{ path('indicator_edit', { id: indicator.id }) }}">Editar indicador</a>{% endif %}
    </div>

    {% if indicator.measurementDescription %}
        <div class="card">
            <h2>Descripción de la medición</h2>
            <p>{{ indicator.measurementDescription|nl2br }}</p>
        </div>
    {% endif %}

    <div class="page-head">
        <h2>Mediciones</h2>
        {% if can_write %}<a class="btn" href="{{ path('indicator_measurement_new', { id: indicator.id }) }}">+ Añadir medición</a>{% endif %}
    </div>

    <div class="card">
        {% if indicator.measurements is empty %}
            <div class="empty-state">
                <h2>Sin mediciones registradas</h2>
                <p>Registra la primera medición del indicador.</p>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Año</th><th>Mes</th><th>Valor</th><th>Estado {{ help_button('indicador-estado') }}</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for measurement in indicator.measurements %}
                        <tr>
                            <td>{{ measurement.year }}</td>
                            <td>{{ month_names[measurement.month] }}</td>
                            <td class="mono">{{ measurement.value|decimal }}</td>
                            <td>
                                {%- if measurement.breached -%}
                                    <span class="val--critical">Transgrede</span>{% if can_write %} · <a href="{{ path('non_conformity_new', { origin: 'internal', description: 'Indicador fuera del valor de referencia: ' ~ indicator.name ~ ' (' ~ month_names[measurement.month] ~ ' ' ~ measurement.year ~ '), valor ' ~ measurement.value|decimal ~ ', referencia ' ~ (indicator.referenceValue ?? 'n/d') }) }}">Abrir NC</a>{% endif %}
                                {%- else -%}
                                    <span class="val--trivial">En objetivo</span>
                                {%- endif -%}
                            </td>
                            <td>{% if can_write %}<a href="{{ path('indicator_measurement_edit', { id: indicator.id, measurementId: measurement.id }) }}">Editar</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
