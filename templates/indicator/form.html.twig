{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Registrar' : 'Editar' }} indicador{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('indicator_index') }}">Indicadores</a><span class="sep">/</span>
    {{ isNew ? 'Registrar' : indicator.name }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Registrar indicador' : 'Editar ' ~ indicator.name }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.name, form.process, form.measurementDescription, form.referenceValue, form.periodicity, form.active]) }}
            {{ f.actions(path('indicator_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
