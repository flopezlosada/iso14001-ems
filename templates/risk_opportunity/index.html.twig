{% extends 'app_shell.html.twig' %}

{% block title %}Riesgos y oportunidades{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Riesgos y oportunidades{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::RISK_OPPORTUNITY')) %}
    <div class="page-head">
        <div>
            <h1>Riesgos y oportunidades</h1>
            <p class="lead">Identificación, valoración y planes de acción (PC.03.0 / F.08.0).</p>
        </div>
        <div>
            {% if can_write and previousExerciseCount > 0 %}
                {# Crea borradores de valoración del curso actual copiando los del curso anterior (solo los que falten). #}
                <form method="post" action="{{ path('risk_clone_assessments', { exercise: currentExercise }) }}" style="display:inline" data-confirm="¿Clonar a {{ currentExercise|e('html_attr') }} las valoraciones de riesgo del periodo anterior que aún no existan?">
                    <input type="hidden" name="_token" value="{{ csrf_token('risk_clone_assessments' ~ currentExercise) }}">
                    <button type="submit" class="btn secondary">Clonar valoraciones a {{ currentExercise }}</button>
                </form>
            {% endif %}
            <a class="btn secondary" href="{{ path('risk_area_index') }}">Gestionar áreas</a>
            <a class="btn" href="{{ path('risk_new') }}">+ Registrar</a>
        </div>
    </div>

    {# Guía "qué falta este curso": diagnóstico de pendientes (no un asistente lineal), cada uno
       enlazado a donde se resuelve. El detalle por ítem (valorar/aprobar/añadir acción) vive en la
       ficha de cada riesgo, a la que lleva el inventario de abajo. #}
    <div class="card workflow-guide">
        <div class="page-head">
            <div>
                <h2>Trabajo de este curso ({{ currentExercise }})</h2>
                <p class="lead muted">Qué hay que hacer aquí y qué te falta.</p>
            </div>
            {% if status.isComplete %}<span class="badge badge--success">Al día para {{ currentExercise }}</span>{% endif %}
        </div>
        {% set has_items = status.totalItems > 0 %}
        <ol class="workflow-steps">
            <li class="workflow-step {{ status.dafoReady ? 'is-done' : 'is-pending' }}">
                <span class="workflow-step-label">Contexto — análisis DAFO del curso <span class="muted">(F.06.0)</span></span>
                <span class="workflow-step-aside">
                    {% if status.dafoReady %}
                        <a class="muted" href="{{ path('dafo_show', { id: status.dafoId }) }}">ver el DAFO {{ currentExercise }}</a>
                    {% else %}
                        <a class="btn secondary" href="{{ path('dafo_new') }}">Crear el DAFO {{ currentExercise }}</a>
                    {% endif %}
                </span>
            </li>
            <li class="workflow-step {{ has_items ? 'is-done' : 'is-pending' }}">
                <span class="workflow-step-label">Identificar riesgos y oportunidades <span class="muted">· {{ status.totalItems }} registrado(s)</span></span>
                <span class="workflow-step-aside">
                    {% if can_write %}<a class="btn secondary" href="{{ path('risk_new') }}">+ Registrar</a>{% endif %}
                </span>
            </li>
            <li class="workflow-step {{ not has_items ? 'is-blocked' : (status.unvalued > 0 ? 'is-pending' : 'is-done') }}">
                <span class="workflow-step-label">Valorar este curso <span class="muted">(probabilidad × impacto)</span></span>
                <span class="workflow-step-aside">
                    {% if not has_items %}
                        <span class="muted">Requiere riesgos registrados</span>
                    {% elseif status.unvalued > 0 %}
                        <a class="btn secondary" href="{{ path('risk_index') }}?filtro={{ 'estado:Sin valorar'|url_encode }}#inventario">{{ status.unvalued }} sin valorar →</a>
                    {% else %}
                        <span class="muted">Hecho</span>
                    {% endif %}
                </span>
            </li>
            <li class="workflow-step {{ not has_items ? 'is-blocked' : (status.unapproved > 0 ? 'is-pending' : 'is-done') }}">
                <span class="workflow-step-label">Aprobar las valoraciones <span class="muted">(Dirección)</span></span>
                <span class="workflow-step-aside">
                    {% if not has_items %}
                        <span class="muted">Requiere riesgos valorados</span>
                    {% elseif status.unapproved > 0 %}
                        <a class="btn secondary" href="{{ path('risk_index') }}?filtro={{ 'estado:Pendiente de aprobar'|url_encode }}#inventario">{{ status.unapproved }} sin aprobar →</a>
                    {% else %}
                        <span class="muted">Hecho</span>
                    {% endif %}
                </span>
            </li>
            <li class="workflow-step {{ not has_items ? 'is-blocked' : (status.relevantWithoutActions > 0 ? 'is-pending' : 'is-done') }}">
                <span class="workflow-step-label">Plan de acción para los relevantes <span class="muted">(crítico/moderado)</span></span>
                <span class="workflow-step-aside">
                    {% if not has_items %}
                        <span class="muted">Requiere riesgos valorados</span>
                    {% elseif status.relevantWithoutActions > 0 %}
                        <a class="btn secondary" href="{{ path('risk_index') }}?filtro={{ 'plan:Falta'|url_encode }}#inventario">{{ status.relevantWithoutActions }} sin acción →</a>
                    {% else %}
                        <span class="muted">Hecho</span>
                    {% endif %}
                </span>
            </li>
            <li class="workflow-step {{ status.isComplete ? 'is-pending' : 'is-blocked' }}">
                <span class="workflow-step-label">Cerrar el periodo</span>
                <span class="workflow-step-aside">
                    {% if status.isComplete %}
                        <a class="btn secondary" href="{{ path('obligation_index') }}">Marcar revisado en «Qué toca»</a>
                    {% else %}
                        <span class="muted">Cuando el resto esté al día</span>
                    {% endif %}
                </span>
            </li>
        </ol>
    </div>

    <div class="card" id="inventario">
        {% if items is empty %}
            <div class="empty-state">
                <h2>Aún no hay registros</h2>
                <p>Registra el primer riesgo u oportunidad del centro.</p>
                <a class="btn" href="{{ path('risk_new') }}">Registrar el primero</a>
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr>
                        <th data-filter="tipo">Tipo {{ help_button('riesgo-tipo') }}</th><th>Descripción</th><th data-filter="area">Proceso / Área</th><th data-filter="estado">Estado ({{ currentExercise }})</th><th data-filter="plan">Plan de acción</th><th>Valoración {{ help_button('riesgo-valoracion') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        {# Estado del ítem RESPECTO AL CURSO ACTUAL (no la última valoración, que puede ser de otro curso). #}
                        {% set a = item.assessmentFor(currentExercise) %}
                        {% set relevant = a and a.category and a.category.requiresActionPlan %}
                        <tr>
                            <td>{{ item.type.label }}</td>
                            <td>
                                {%- if a -%}
                                    <a class="cell-link" href="{{ path('risk_assessment_show', { id: item.id, assessmentId: a.id }) }}">{{ item.description }}</a>
                                {%- else -%}
                                    <a class="cell-link" href="{{ path('risk_show', { id: item.id }) }}">{{ item.description }}</a>
                                {%- endif -%}
                            </td>
                            <td class="muted">{{ item.processArea.name }}</td>
                            <td>
                                {%- if a is null -%}
                                    {%- if can_write -%}
                                        <a class="badge badge--draft" href="{{ path('risk_assessment_new', { id: item.id }) }}">Sin valorar</a>
                                    {%- else -%}
                                        <span class="badge badge--draft">Sin valorar</span>
                                    {%- endif -%}
                                {%- elseif a.approvedBy -%}
                                    <a class="badge badge--success" href="{{ path('risk_assessment_show', { id: item.id, assessmentId: a.id }) }}">Aprobado</a>
                                {%- else -%}
                                    <a class="badge badge--warning" href="{{ path('risk_assessment_show', { id: item.id, assessmentId: a.id }) }}">Pendiente de aprobar</a>
                                {%- endif -%}
                            </td>
                            <td>
                                {%- if not relevant -%}
                                    <span class="muted">—</span>
                                {%- else -%}
                                    {%- set plan_done = a.actions|length > 0 -%}
                                    <a class="badge {{ plan_done ? 'badge--success' : 'badge--warning' }}" href="{{ path('risk_assessment_show', { id: item.id, assessmentId: a.id }) }}#plan">{{ plan_done ? 'Hecho' : 'Falta' }}</a>
                                {%- endif -%}
                            </td>
                            <td>
                                {%- if a and a.category -%}
                                    {%- set val_class = { 'critical': 'val--critical', 'moderate': 'val--moderate', 'trivial': 'val--trivial' } -%}
                                    <span class="{{ val_class[a.category.value] }}">{{ a.category.label(item.type) }} · {{ a.score }}</span>
                                {%- else -%}
                                    <span class="muted">—</span>
                                {%- endif -%}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
