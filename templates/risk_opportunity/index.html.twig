{% extends 'app_shell.html.twig' %}

{% block title %}Riesgos y oportunidades{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Riesgos y oportunidades{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::RISK_OPPORTUNITY')) %}
    <div class="page-head">
        <div>
            <h1>Riesgos y oportunidades</h1>
            <p class="lead">Identificación, valoración y planes de acción (PC.03.0 / F.08.0).</p>
        </div>
        <div>
            {% if can_write and nextExercise %}
                {# Crea borradores de valoración del curso siguiente a partir del último valorado (solo los que falten). #}
                <form method="post" action="{{ path('risk_clone_assessments') }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('risk_clone_assessments') }}">
                    <button type="submit" class="btn secondary">Clonar valoraciones a {{ nextExercise }}</button>
                </form>
            {% endif %}
            <a class="btn secondary" href="{{ path('risk_area_index') }}">Gestionar áreas</a>
            <a class="btn" href="{{ path('risk_new') }}">+ Registrar</a>
        </div>
    </div>

    <div class="card">
        {% if items is empty %}
            <div class="empty-state">
                <h2>Aún no hay registros</h2>
                <p>Registra el primer riesgo u oportunidad del centro.</p>
                <a class="btn" href="{{ path('risk_new') }}">Registrar el primero</a>
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr>
                        <th data-filter>Tipo</th><th>Descripción</th><th>Proceso / Área</th><th>Valoración actual</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        {% set latest = item.latestAssessment %}
                        <tr>
                            <td>{{ item.type.label }}</td>
                            <td><a class="cell-link" href="{{ path('risk_show', { id: item.id }) }}">{{ item.description }}</a></td>
                            <td class="muted">{{ item.processArea.name }}</td>
                            <td>
                                {%- if latest -%}
                                    {{ latest.category ? latest.category.label(item.type) : '—' }}
                                    <span class="muted">· {{ latest.score }} ({{ latest.exercise }})</span>
                                {%- else -%}
                                    <span class="muted">Sin valorar</span>
                                {%- endif -%}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
