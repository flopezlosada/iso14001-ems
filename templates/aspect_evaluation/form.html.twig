{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Nueva evaluación' : 'Editar evaluación ' ~ evaluation.year }} · {{ aspect.name }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('aspect_index') }}">Aspectos ambientales</a><span class="sep">/</span>
    <a href="{{ path('aspect_show', { id: aspect.id }) }}">{{ aspect.name }}</a><span class="sep">/</span>
    {{ isNew ? 'Nueva evaluación' : 'Evaluación ' ~ evaluation.year }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Nueva evaluación' : 'Editar evaluación ' ~ evaluation.year }} · {{ aspect.name }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {% if intensityEstimate is not null %}
                <p class="help" style="background: var(--surface-2, #f4f7f4); border-left: 3px solid var(--accent, #2e7d32); padding: .6rem .8rem; margin-bottom: 1rem; color: var(--text, inherit);">
                    <strong>Intensidad sugerida:</strong> {{ intensityEstimate.level.label }} ({{ intensityEstimate.level.value }}) —
                    el consumo de este año va {{ intensityEstimate.changeRatio >= 0 ? '+' : '' }}{{ (intensityEstimate.changeRatio * 100)|round(1) }}% respecto a años anteriores.
                    Revísala y ajústala si procede.
                </p>
            {% endif %}
            {# The criteria fields depend on the aspect type, so we gather them at runtime (dropping the
               CSRF token) and hand the list to the shared macro, which renders each row AND the
               per-field "?" when the field declares a help_slug. #}
            {% set criteria = [] %}
            {% for child in form if child.vars.name != '_token' %}
                {% set criteria = criteria|merge([child]) %}
            {% endfor %}
            {{ f.fields(criteria) }}
            <p class="help">La suma y el resultado se calculan automáticamente al guardar (salvo en indirectos, sin umbral definido).</p>
            {{ f.actions(path('aspect_show', { id: aspect.id })) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
