{% extends 'app_shell.html.twig' %}
{% import 'document/_macros.html.twig' as m %}

{% block title %}Qué toca{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Qué toca{% endblock %}

{# Urgency bucket → heading, badge style and short description. Keys match ObligationUrgency values. #}
{% set buckets = {
    'overdue':      { label: 'Vencido',       badge: 'badge--danger',  desc: 'Pasada la fecha de revisión. Atiéndelo cuanto antes.' },
    'due_soon':     { label: 'Próximo',       badge: 'badge--warning', desc: 'Vence dentro de los próximos 30 días.' },
    'on_track':     { label: 'Al día',        badge: 'badge--success', desc: 'Sin acción inmediata.' },
    'event_driven': { label: 'Según evento',  badge: 'badge',          desc: 'Sin fecha fija: se cumplimenta cuando ocurre el evento.' }
} %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Qué toca</h1>
            <p class="lead">
                {%- if scope == 'mias' -%}
                    Tus obligaciones del sistema de gestión, ordenadas por urgencia.
                {%- else -%}
                    Todas las obligaciones del centro, ordenadas por urgencia.
                {%- endif %} {{ today|date('d/m/Y') }}.
            </p>
        </div>
        <a class="btn secondary" href="{{ path('obligation_structure') }}">Ver estructura del SGA</a>
    </div>

    {# Ámbito: lo del usuario (por defecto, como el inicio) o todo el centro (Dirección / auditor). #}
    <div class="scope-toggle" role="group" aria-label="Ámbito de las obligaciones">
        <a href="{{ path('obligation_index', { scope: 'mias' }) }}" class="{{ scope == 'mias' ? 'is-active' }}"{{ scope == 'mias' ? ' aria-current="page"' }}>Mías ({{ mineCount }})</a>
        <a href="{{ path('obligation_index', { scope: 'todas' }) }}" class="{{ scope == 'todas' ? 'is-active' }}"{{ scope == 'todas' ? ' aria-current="page"' }}>Todas ({{ totalCount }})</a>
    </div>

    {{ include('partials/_aspects_to_watch.html.twig') }}

    {% set anything = false %}
    {% for key, meta in buckets %}
        {% set items = groups[key] %}
        {% if items is not empty %}
            {% set anything = true %}
            <section class="obligation-group" id="{{ key }}">
                <div class="obligation-group-head">
                    <span class="badge {{ meta.badge }}">{{ meta.label }}</span>
                    <span class="muted">{{ items|length }} · {{ meta.desc }}</span>
                </div>
                <div class="card">
                    {{ m.obligation_table(items, moduleRoutes, true, scope, inForceIds) }}
                </div>
            </section>
        {% endif %}
    {% endfor %}

    {% if done is not empty %}
        <section class="obligation-group" id="done">
            <div class="obligation-group-head">
                <span class="badge badge--done">Hecho</span>
                <span class="muted">{{ done|length }} · Cumplimentadas este periodo. Sin más acción hasta la próxima revisión.</span>
            </div>
            <div class="card">
                {# Sin canComplete a propósito: ya están hechas para este periodo. #}
                {{ m.obligation_table(done, moduleRoutes) }}
            </div>
        </section>
    {% endif %}

    {% if notApplicable is not empty %}
        <section class="obligation-group" id="not_applicable">
            <div class="obligation-group-head">
                <span class="badge">No aplica</span>
                <span class="muted">{{ notApplicable|length }} · Marcadas como no aplicables actualmente.</span>
            </div>
            <div class="card">
                {# Sin canComplete a propósito: las no-aplicables no se cierran por periodo. #}
                {{ m.obligation_table(notApplicable, moduleRoutes) }}
            </div>
        </section>
    {% endif %}

    {% if not anything and done is empty and notApplicable is empty %}
        <div class="empty-state">
            {% if scope == 'mias' and totalCount > 0 %}
                <h2>No tienes obligaciones asignadas</h2>
                <p>No hay obligaciones bajo tu responsabilidad. <a href="{{ path('obligation_index', { scope: 'todas' }) }}">Ver todas las del centro</a>.</p>
            {% else %}
                <h2>No hay obligaciones registradas</h2>
                <p>Cuando se cargue el catálogo de obligaciones, aquí verás qué toca y cuándo.</p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
