{% extends 'app_shell.html.twig' %}

{# Clase de badge por estado de versión (VersionStatus). #}
{% set version_badge = { 'draft': 'badge--draft', 'in_review': 'badge--warning', 'approved': 'badge--success', 'obsolete': 'badge' } %}

{% block title %}{{ document.code ?? document.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    {{ document.code ?? document.title }}
{% endblock %}

{% block body %}
    {% if not document.isActive %}
        <div class="lifecycle-banner">
            <span class="badge {{ document.lifecycle.value == 'cancelled' ? 'badge--danger' : 'badge--draft' }}">{{ document.lifecycle.label }}</span>
            {% if document.lifecycleReason %}<span class="muted">{{ document.lifecycleReason }}</span>{% endif %}
        </div>
    {% endif %}

    <div class="page-head">
        <div>
            <p class="eyebrow">{% if document.code %}<span class="mono">{{ document.code }}</span> · {% endif %}{{ document.type.label }}</p>
            <h1>{{ document.title }}</h1>
            {# "Versión en vigor" solo aplica a documentos que se redactan (política/manual/procedimiento).
               Un formato/registro no tiene texto aprobado: su contenido vive en el módulo. #}
            {% if document.type.isDrafted %}
                <p class="lead">
                    {% if current %}
                        En vigor: revisión {{ current.revisionNumber }} · {{ current.issueDate|date('d/m/Y') }}
                    {% else %}
                        <span class="badge badge--warning">Sin versión en vigor</span>
                    {% endif %}
                </p>
            {% else %}
                <p class="lead muted">{{ document.type.label }} · se cumplimenta en su módulo</p>
            {% endif %}
        </div>
        {% if moduleRoute %}<a class="btn secondary" href="{{ path(moduleRoute) }}">Ir al módulo</a>{% endif %}
    </div>

    <div class="card">
        <dl class="detail-grid">
            <dt>Tipo</dt><dd>{{ document.type.label }}</dd>
            {% if document.linkedArea %}<dt>Área / módulo</dt><dd>{{ document.linkedArea.label }}</dd>{% endif %}
            {% if document.process %}<dt>Proceso</dt><dd>{{ document.process }}</dd>{% endif %}
            <dt>Responsable</dt><dd>{{ document.responsibleRole ? document.responsibleRole.name : '—' }}</dd>
            <dt>Estado</dt><dd>{{ document.status.label }}{% if document.statusNote %} <span class="muted">· {{ document.statusNote }}</span>{% endif %}</dd>
            <dt>Situación</dt><dd>{{ document.lifecycle.label }}{% if document.lifecycleReason %} <span class="muted">· {{ document.lifecycleReason }}</span>{% endif %}</dd>
            <dt>Retención</dt><dd>{{ document.retentionYears ? document.retentionYears ~ ' años' : 'Indefinida' }}</dd>
            {% if document.legacyCodes is not empty %}<dt>Códigos anteriores</dt><dd class="mono muted">{{ document.legacyCodes|join(', ') }}</dd>{% endif %}
        </dl>
        {% if document.instructions %}
            <h2>Instrucciones</h2>
            <p>{{ document.instructions|nl2br }}</p>
        {% endif %}
    </div>

    {# El documento redactado (solo política/manual/procedimiento): editor, cuerpo y ciclo de versiones.
       Un formato/registro no se redacta —su contenido vive en el módulo—, así que este bloque y el
       historial de versiones no se muestran para ellos. #}
    {% if document.type.isDrafted %}
    <div class="page-head">
        <div><h2>Documento</h2></div>
        {% if document.isActive and is_granted('DOCUMENT_ISSUE', document) %}
            {% if displayVersion and displayVersion.status.isEditable %}
                <a class="btn secondary" href="{{ path('document_revision_edit', { id: document.id, versionId: displayVersion.id }) }}">Editar documento</a>
            {% elseif not displayVersion %}
                <a class="btn secondary" href="{{ path('document_revision_compose', { id: document.id }) }}">Redactar documento</a>
            {% endif %}
        {% endif %}
    </div>
    <div class="card">
        {% if displayVersion and displayVersion.body %}
            {% if not (current and displayVersion.id == current.id) %}
                <p class="muted">Mostrando el contenido de la revisión {{ displayVersion.revisionNumber }} ({{ displayVersion.status.label|lower }}), aún sin aprobar.</p>
            {% endif %}
            <div class="document-body">{{ displayVersion.body|raw }}</div>
        {% elseif current %}
            <p class="muted">La revisión en vigor aún no tiene contenido redactado. Emite una nueva revisión para añadirlo.</p>
        {% else %}
            <p class="muted">Aún no hay contenido redactado del documento.{% if document.isActive and is_granted('DOCUMENT_ISSUE', document) %} Redáctalo para crearlo.{% endif %}</p>
        {% endif %}
    </div>
    {% endif %}

    {# Cierres de revisión de periodo (del audit-log): cuándo se marcó "hecho" cada periodo desde
       "Qué toca". No aplica a documentos redactados: para ellos la revisión periódica ES emitir una
       nueva revisión (historial de versiones). #}
    {% if (document.hasFixedCadence or reviews is not empty) and not document.type.isDrafted %}
        <div class="page-head"><h2>Revisiones de periodo</h2></div>
        <div class="card">
            {% if reviews is empty %}
                <p class="muted">Aún no se ha cerrado ninguna revisión de periodo desde la aplicación. Se registran al marcar la obligación como hecha en «Qué toca».</p>
            {% else %}
                <ul class="activity">
                    {% for r in reviews %}
                        <li>
                            <span class="activity-when mono">{{ r.occurredAt|date('d/m/Y H:i') }}</span>
                            <span class="activity-what">{{ r.summary ?? 'Revisión del periodo cerrada' }}</span>
                            <span class="activity-who muted">{{ r.actor ?? 'sistema' }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}

    {% if document.type.isDrafted %}
    <div class="page-head">
        <div><h2>Historial de versiones {{ help_button('documento-ciclo-revision') }}</h2></div>
        {% if document.isActive and is_granted('DOCUMENT_ISSUE', document) and not hasOpenRevision and versions is not empty %}
            <a class="btn secondary" href="{{ path('document_revision_compose', { id: document.id }) }}">Emitir nueva revisión</a>
        {% endif %}
    </div>

    {% set can_approve = is_granted('DOCUMENT_APPROVE', document) %}
    <div class="card">
        {% if versions is empty %}
            <div class="empty-state">
                <h2>Aún no hay versiones</h2>
                <p>Cuando se emita la primera revisión del documento, aparecerá aquí con su aprobación.</p>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr><th>Rev.</th><th>Fecha</th><th>Estado</th><th>Autor</th><th>Cambios</th><th>Acción</th><th>Documento</th></tr>
                </thead>
                <tbody>
                    {% for v in versions %}
                        {% set ap = v.latestApproval %}
                        {% set is_current = current and v.id == current.id %}
                        <tr class="{{ is_current ? 'is-in-force' }}">
                            <td class="mono">{{ v.revisionNumber }}{% if is_current %} <span class="badge badge--success">En vigor</span>{% endif %}</td>
                            <td>{{ v.issueDate|date('d/m/Y') }}</td>
                            <td><span class="badge {{ version_badge[v.status.value] ?? 'badge--draft' }}">{{ v.status.label }}</span></td>
                            <td>{{ v.author ?? '—' }}</td>
                            <td class="muted">{{ v.changeSummary ?? '—' }}</td>
                            <td>
                                {%- if ap -%}
                                    {{ ap.approver.fullName }} <span class="muted">· {{ ap.approvedAt|date('d/m/Y') }}</span>
                                    {% if ap.digitallySigned %} <span class="badge badge--success" title="Firma digital adjunta">Firmada</span>{% endif %}
                                    <span class="mono muted" title="Hash de integridad: {{ ap.integrityHash|e('html_attr') }}">· {{ ap.integrityHash|slice(0, 10) }}…</span>
                                {%- elseif document.isActive and v.status.value == 'draft' and is_granted('DOCUMENT_ISSUE', document) -%}
                                    <form method="post" action="{{ path('document_revision_submit', { id: document.id, versionId: v.id }) }}" class="inline-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('document_submit' ~ document.id) }}">
                                        <button class="btn secondary" type="submit">Enviar a revisión</button>
                                    </form>
                                {%- elseif document.isActive and v.status.value == 'in_review' and not v.reviewed and is_granted('DOCUMENT_REVIEW', document) -%}
                                    <form method="post" action="{{ path('document_revision_review', { id: document.id, versionId: v.id }) }}" class="inline-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('document_review' ~ document.id) }}">
                                        <button class="btn secondary" type="submit">Revisar</button>
                                    </form>
                                {%- elseif document.isActive and v.status.value == 'in_review' and v.reviewed and can_approve -%}
                                    <form method="post" action="{{ path('document_revision_approve', { id: document.id, versionId: v.id }) }}" class="inline-form" data-confirm="¿Aprobar esta versión del documento? Quedará como versión vigente.">

                                        <input type="hidden" name="_token" value="{{ csrf_token('document_approve' ~ document.id) }}">
                                        <button class="btn secondary" type="submit">Aprobar</button>
                                    </form>
                                {%- elseif v.reviewed -%}
                                    <span class="muted">Revisado{% if v.reviewedBy %} por {{ v.reviewedBy }}{% endif %} · pendiente de aprobar</span>
                                {%- elseif v.status.value == 'in_review' -%}
                                    <span class="muted">En revisión · pendiente de revisar</span>
                                {%- else -%}
                                    <span class="muted">Pendiente</span>
                                {%- endif -%}
                            </td>
                            <td>
                                {%- if v.status.isEditable and document.isActive and is_granted('DOCUMENT_ISSUE', document) %}
                                    <a href="{{ path('document_revision_edit', { id: document.id, versionId: v.id }) }}">Editar</a>
                                    <span class="muted"> · </span>
                                {%- endif %}
                                <a href="{{ path('document_revision_pdf', { id: document.id, versionId: v.id }) }}" target="_blank" rel="noopener">
                                    {{ ap ? 'PDF oficial' : 'Vista previa' }}
                                </a>
                                {%- if ap %}
                                    {% if ap.digitallySigned %}
                                        <span class="muted"> · </span><a href="{{ path('document_revision_signed_download', { id: document.id, versionId: v.id }) }}">PDF firmado</a>
                                    {% elseif can_approve %}
                                        <span class="muted"> · </span>
                                        <a href="{{ path('document_revision_sign_form', { id: document.id, versionId: v.id }) }}">Adjuntar firma…</a>
                                    {% endif %}
                                {% endif -%}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
    {% endif %}

    {# Acciones administrativas del documento, al final: poco frecuentes y de cuidado (anular/archivar). #}
    {% if is_granted('DOCUMENT_LIFECYCLE', document) %}
        <div class="page-head"><h2>Control del documento</h2></div>
        <div class="card">
            <p class="muted">Los documentos no se borran: se anulan (con motivo) o se archivan, dejando rastro para la auditoría.</p>
            {% if document.isActive %}
                <div class="form-actions">
                    <a class="btn danger" href="{{ path('document_lifecycle_confirm', { id: document.id, action: 'cancel' }) }}">Anular…</a>
                    <a class="btn secondary" href="{{ path('document_lifecycle_confirm', { id: document.id, action: 'archive' }) }}">Archivar…</a>
                </div>
            {% else %}
                <form method="post" action="{{ path('document_lifecycle', { id: document.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('document_lifecycle' ~ document.id) }}">
                    <input type="hidden" name="action" value="restore">
                    <button class="btn secondary" type="submit">Reactivar documento</button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    {{ include('partials/_activity_log.html.twig', { entries: activity }) }}
{% endblock %}
