{% extends 'app_shell.html.twig' %}

{# Clase de badge por estado de versión (VersionStatus). #}
{% set version_badge = { 'draft': 'badge--draft', 'in_review': 'badge--warning', 'approved': 'badge--success', 'obsolete': 'badge' } %}

{% block title %}{{ document.code ?? document.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    {{ document.code ?? document.title }}
{% endblock %}

{% block body %}
    {% if not document.isActive %}
        <div class="lifecycle-banner">
            <span class="badge {{ document.lifecycle.value == 'cancelled' ? 'badge--danger' : 'badge--draft' }}">{{ document.lifecycle.label }}</span>
            {% if document.lifecycleReason %}<span class="muted">{{ document.lifecycleReason }}</span>{% endif %}
        </div>
    {% endif %}

    <div class="page-head">
        <div>
            <p class="eyebrow">{% if document.code %}<span class="mono">{{ document.code }}</span> · {% endif %}{{ document.type.label }}</p>
            <h1>{{ document.title }}</h1>
            <p class="lead">
                {% if current %}
                    En vigor: revisión {{ current.revisionNumber }} · {{ current.issueDate|date('d/m/Y') }}
                {% else %}
                    <span class="badge badge--warning">Sin versión en vigor</span>
                {% endif %}
            </p>
        </div>
        {% if moduleRoute %}<a class="btn secondary" href="{{ path(moduleRoute) }}">Ir al módulo</a>{% endif %}
    </div>

    <div class="card">
        <dl class="detail-grid">
            <dt>Tipo</dt><dd>{{ document.type.label }}</dd>
            {% if document.linkedArea %}<dt>Área / módulo</dt><dd>{{ document.linkedArea.label }}</dd>{% endif %}
            {% if document.process %}<dt>Proceso</dt><dd>{{ document.process }}</dd>{% endif %}
            <dt>Responsable</dt><dd>{{ document.responsibleRole ? document.responsibleRole.name : '—' }}</dd>
            <dt>Estado</dt><dd>{{ document.status.label }}{% if document.statusNote %} <span class="muted">· {{ document.statusNote }}</span>{% endif %}</dd>
            <dt>Situación</dt><dd>{{ document.lifecycle.label }}{% if document.lifecycleReason %} <span class="muted">· {{ document.lifecycleReason }}</span>{% endif %}</dd>
            <dt>Retención</dt><dd>{{ document.retentionYears ? document.retentionYears ~ ' años' : 'Indefinida' }}</dd>
            {% if document.legacyCodes is not empty %}<dt>Códigos anteriores</dt><dd class="mono muted">{{ document.legacyCodes|join(', ') }}</dd>{% endif %}
        </dl>
        {% if document.instructions %}
            <h2>Instrucciones</h2>
            <p>{{ document.instructions|nl2br }}</p>
        {% endif %}
    </div>

    {% if is_granted('DOCUMENT_LIFECYCLE', document) %}
        <div class="card">
            <h2>Control del documento</h2>
            <p class="muted">Los documentos no se borran: se anulan (con motivo) o se archivan, dejando rastro para la auditoría.</p>
            {% if document.isActive %}
                <form method="post" action="{{ path('document_lifecycle', { id: document.id }) }}" class="lifecycle-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('document_lifecycle' ~ document.id) }}">
                    <input type="hidden" name="action" value="cancel">
                    <input type="text" name="reason" aria-label="Motivo de la anulación" placeholder="Motivo de la anulación…">
                    <button class="btn danger" type="submit">Anular</button>
                </form>
                <form method="post" action="{{ path('document_lifecycle', { id: document.id }) }}" class="lifecycle-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('document_lifecycle' ~ document.id) }}">
                    <input type="hidden" name="action" value="archive">
                    <input type="text" name="reason" aria-label="Motivo del archivado (opcional)" placeholder="Motivo del archivado (opcional)…">
                    <button class="btn secondary" type="submit">Archivar</button>
                </form>
            {% else %}
                <form method="post" action="{{ path('document_lifecycle', { id: document.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('document_lifecycle' ~ document.id) }}">
                    <input type="hidden" name="action" value="restore">
                    <button class="btn secondary" type="submit">Reactivar documento</button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    <div class="page-head"><h2>Historial de versiones</h2></div>

    {% if document.isActive and is_granted('DOCUMENT_ISSUE', document) %}
        <form method="post" action="{{ path('document_revision_new', { id: document.id }) }}" class="lifecycle-form">
            <input type="hidden" name="_token" value="{{ csrf_token('document_revision' ~ document.id) }}">
            <input type="text" name="changeSummary" aria-label="Resumen de los cambios" placeholder="Resumen de los cambios de la nueva revisión…">
            <button class="btn" type="submit">Nueva revisión</button>
        </form>
    {% endif %}

    {% set can_approve = is_granted('DOCUMENT_APPROVE', document) %}
    <div class="card">
        {% if versions is empty %}
            <div class="empty-state">
                <h2>Aún no hay versiones</h2>
                <p>Cuando se emita la primera revisión del documento, aparecerá aquí con su aprobación.</p>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr><th>Rev.</th><th>Fecha</th><th>Estado</th><th>Autor</th><th>Cambios</th><th>Aprobación</th><th>Documento</th></tr>
                </thead>
                <tbody>
                    {% for v in versions %}
                        {% set ap = v.latestApproval %}
                        {% set is_current = current and v.id == current.id %}
                        <tr class="{{ is_current ? 'is-in-force' }}">
                            <td class="mono">{{ v.revisionNumber }}{% if is_current %} <span class="badge badge--success">En vigor</span>{% endif %}</td>
                            <td>{{ v.issueDate|date('d/m/Y') }}</td>
                            <td><span class="badge {{ version_badge[v.status.value] ?? 'badge--draft' }}">{{ v.status.label }}</span></td>
                            <td>{{ v.author ?? '—' }}</td>
                            <td class="muted">{{ v.changeSummary ?? '—' }}</td>
                            <td>
                                {%- if ap -%}
                                    {{ ap.approver.fullName }} <span class="muted">· {{ ap.approvedAt|date('d/m/Y') }}</span>
                                    {% if ap.digitallySigned %} <span class="badge badge--success" title="Firma digital adjunta">Firmada</span>{% endif %}
                                    <span class="mono muted" title="Hash de integridad: {{ ap.integrityHash|e('html_attr') }}">· {{ ap.integrityHash|slice(0, 10) }}…</span>
                                {%- elseif can_approve and document.isActive and v.status.value in ['draft', 'in_review'] -%}
                                    <form method="post" action="{{ path('document_revision_approve', { id: document.id, versionId: v.id }) }}" class="inline-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('document_approve' ~ document.id) }}">
                                        <button class="btn secondary" type="submit">Aprobar</button>
                                    </form>
                                {%- else -%}
                                    <span class="muted">Pendiente</span>
                                {%- endif -%}
                            </td>
                            <td>
                                <a href="{{ path('document_revision_pdf', { id: document.id, versionId: v.id }) }}" target="_blank" rel="noopener">
                                    {{ ap ? 'PDF oficial' : 'Vista previa' }}
                                </a>
                                {%- if ap %}
                                    {% if ap.digitallySigned %}
                                        <span class="muted"> · </span><a href="{{ path('document_revision_signed_download', { id: document.id, versionId: v.id }) }}">PDF firmado</a>
                                    {% elseif can_approve %}
                                        <form method="post" enctype="multipart/form-data" action="{{ path('document_revision_sign', { id: document.id, versionId: v.id }) }}" class="inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('document_sign' ~ document.id) }}">
                                            <input type="file" name="signedPdf" accept="application/pdf" aria-label="PDF firmado">
                                            <button class="btn secondary" type="submit">Adjuntar firma</button>
                                        </form>
                                    {% endif %}
                                {% endif -%}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
