{# Reusable rendering of one obligation row, shared by the "Qué toca" and "Estructura SGA" views.
   `moduleRoutes` maps a linked Area value to its module index route. An obligation that is filled in
   from a module (e.g. Riesgos y Oportunidades) links its title straight to that module —where the
   real work happens— and offers both a "Cumplimentar" and a "Control documental" action. An
   obligation with no module (e.g. the Environmental Policy) links its title to its control sheet and
   only offers "Control documental", since there is nothing to fill in. Every obligation always has a
   control sheet, so the "Control documental" action is shown on every row. #}

{% macro obligation_row(obl, moduleRoutes, canComplete = false, scope = null, inForceIds = []) %}
    {% set area = obl.linkedArea %}
    {% set hasModule = area and moduleRoutes[area.value] is defined %}
    <tr>
        <td>
            <span class="mono">{{ obl.code }}</span>
            <div><a class="cell-link" href="{{ hasModule ? path(moduleRoutes[area.value]) : path('document_show', { id: obl.id }) }}">{{ obl.title }}</a></div>
            {% if obl.instructions %}<div class="muted obligation-help">{{ obl.instructions }}</div>{% endif %}
        </td>
        <td>{{ obl.responsibleRole ? obl.responsibleRole.name : '—' }}</td>
        <td>
            {% if obl.nextReviewDate %}
                {{ obl.nextReviewDate|date('d/m/Y') }}
            {% else %}
                <span class="muted">Según evento</span>
            {% endif %}
        </td>
        <td>
            {{ obl.status.label }}{% if obl.statusNote %}<div class="muted">{{ obl.statusNote }}</div>{% endif %}
            {% if obl.lastCompletedOn %}<div class="muted">Última revisión: {{ obl.lastCompletedOn|date('d/m/Y') }}</div>{% endif %}
        </td>
        <td class="row-actions">
            {% if hasModule %}
                <a class="btn secondary" href="{{ path(moduleRoutes[area.value]) }}">Cumplimentar</a>
            {% endif %}
            {# Toda obligación tiene ficha de control documental, tenga módulo de cumplimentación o no. #}
            <a class="btn secondary" href="{{ path('document_show', { id: obl.id }) }}">Control documental</a>
            {% if canComplete and obl.hasFixedCadence and is_granted('DOCUMENT_COMPLETE', obl) %}
                {% if obl.id in inForceIds %}
                    {# Solo se puede marcar revisado un documento en vigor: no puedes haber revisado algo que aún no existe. #}
                    <form method="post" action="{{ path('obligation_complete', { id: obl.id, scope: scope }) }}" class="inline-form"
                          data-confirm="¿Marcar como revisada esta obligación? Se registrará la revisión con la fecha de hoy y el aviso volverá a activarse en el siguiente periodo.">
                        <input type="hidden" name="_token" value="{{ csrf_token('obligation_complete' ~ obl.id) }}">
                        <button type="submit" class="btn">Marcar revisado</button>
                    </form>
                {% else %}
                    <span class="muted" title="Aprueba una versión del documento en su ficha de control documental antes de poder marcar su revisión.">Pendiente de aprobar</span>
                {% endif %}
            {% endif %}
        </td>
    </tr>
{% endmacro %}

{# Table wrapper around a list of obligation rows, with a shared header. #}
{% macro obligation_table(obligations, moduleRoutes, canComplete = false, scope = null, inForceIds = []) %}
    {% import _self as m %}
    <table>
        <thead>
            <tr>
                <th>Documento</th><th>Responsable</th><th>Próxima revisión</th><th>Estado</th><th></th>
            </tr>
        </thead>
        <tbody>
            {% for obl in obligations %}
                {{ m.obligation_row(obl, moduleRoutes, canComplete, scope, inForceIds) }}
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}
