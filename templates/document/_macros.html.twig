{# Reusable rendering of one obligation row, shared by the "Qué toca" and "Estructura SGA" views.
   `moduleRoutes` maps a linked Area value to its module index route; an obligation with no module
   (e.g. the Environmental Policy, managed through document control rather than a data-entry CRUD)
   links to its control sheet ("Abrir ficha") instead. #}

{% macro obligation_row(obl, moduleRoutes, canComplete = false, scope = null) %}
    {% set area = obl.linkedArea %}
    <tr>
        <td>
            <span class="mono">{{ obl.code }}</span>
            <div><a class="cell-link" href="{{ path('document_show', { id: obl.id }) }}">{{ obl.title }}</a></div>
            {% if obl.instructions %}<div class="muted obligation-help">{{ obl.instructions }}</div>{% endif %}
        </td>
        <td>{{ obl.responsibleRole ? obl.responsibleRole.name : '—' }}</td>
        <td>
            {% if obl.nextReviewDate %}
                {{ obl.nextReviewDate|date('d/m/Y') }}
            {% else %}
                <span class="muted">Según evento</span>
            {% endif %}
        </td>
        <td>
            {{ obl.status.label }}{% if obl.statusNote %}<div class="muted">{{ obl.statusNote }}</div>{% endif %}
            {% if obl.lastCompletedOn %}<div class="muted">Última revisión: {{ obl.lastCompletedOn|date('d/m/Y') }}</div>{% endif %}
        </td>
        <td class="row-actions">
            {% if area and moduleRoutes[area.value] is defined %}
                <a class="btn secondary" href="{{ path(moduleRoutes[area.value]) }}">Cumplimentar</a>
            {% else %}
                {# Sin módulo CRUD propio: se gestiona desde su ficha de control documental. #}
                <a class="btn secondary" href="{{ path('document_show', { id: obl.id }) }}">Abrir ficha</a>
            {% endif %}
            {% if canComplete and obl.hasFixedCadence and is_granted('DOCUMENT_COMPLETE', obl) %}
                <form method="post" action="{{ path('obligation_complete', { id: obl.id, scope: scope }) }}" class="inline-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('obligation_complete' ~ obl.id) }}">
                    <button type="submit" class="btn">Marcar revisado</button>
                </form>
            {% endif %}
        </td>
    </tr>
{% endmacro %}

{# Table wrapper around a list of obligation rows, with a shared header. #}
{% macro obligation_table(obligations, moduleRoutes, canComplete = false, scope = null) %}
    {% import _self as m %}
    <table>
        <thead>
            <tr>
                <th>Documento</th><th>Responsable</th><th>Próxima revisión</th><th>Estado</th><th></th>
            </tr>
        </thead>
        <tbody>
            {% for obl in obligations %}
                {{ m.obligation_row(obl, moduleRoutes, canComplete, scope) }}
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}
