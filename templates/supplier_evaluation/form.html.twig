{% extends 'app_shell.html.twig' %}

{% block title %}{{ isNew ? 'Nueva evaluación' : 'Editar evaluación ' ~ evaluation.year }} · {{ supplier.name }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('supplier_index') }}">Proveedores</a><span class="sep">/</span>
    <a href="{{ path('supplier_show', { id: supplier.id }) }}">{{ supplier.name }}</a><span class="sep">/</span>
    {{ isNew ? 'Nueva evaluación' : 'Evaluación ' ~ evaluation.year }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Nueva evaluación' : 'Editar evaluación ' ~ evaluation.year }} · {{ supplier.name }}</h1>
    </div>

    <div class="card" style="max-width: 560px;">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {% for field in [form.year, form.criterion, form.notes] %}
                <div class="form-row">
                    {{ form_label(field) }}
                    {{ form_widget(field) }}
                    {% if field.vars.help %}<p class="help">{{ field.vars.help }}</p>{% endif %}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
            <button class="btn" type="submit">Guardar</button>
            <a class="btn secondary" href="{{ path('supplier_show', { id: supplier.id }) }}">Cancelar</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
