{% extends 'app_shell.html.twig' %}

{% block title %}Revisión por la dirección · {{ review.exercise }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('management_review_index') }}">Revisión por la dirección</a><span class="sep">/</span>
    {{ review.exercise }}
{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::MANAGEMENT_REVIEW')) %}
    <div class="page-head">
        <div>
            <h1>Revisión por la dirección · {{ review.exercise }} <span class="badge {{ review.status.badgeClass }}">{{ review.status.label }}</span> {{ help_button('revision-estado') }}</h1>
            <p class="lead">
                {% if review.meetingDate %}Reunión: {{ review.meetingDate|date('d/m/Y') }} · {% endif %}
                {% if review.approved %}
                    Aprobada por {{ review.approvedBy ? review.approvedBy.fullName : '—' }}{% if review.approvedAt %} el {{ review.approvedAt|date('d/m/Y') }}{% endif %}
                {% else %}
                    Borrador
                {% endif %}
            </p>
        </div>
        {% if not review.approved %}
            <a class="btn secondary" href="{{ path('management_review_edit', { id: review.id }) }}">Editar</a>
        {% endif %}
    </div>

    <div class="card">
        <h2>Participantes</h2>
        {% if review.participants is empty %}
            <p class="muted">Sin participantes registrados.</p>
        {% else %}
            <ul>
                {% for participant in review.participants %}
                    <li>{{ participant.fullName }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    {% for section in review.sections %}
        <div class="card">
            <h2>{{ section.sectionKey.label }}</h2>
            {% if section.decision %}
                <p><strong>{{ section.decision }}</strong></p>
            {% endif %}
            {% if section.content %}
                <p style="white-space: pre-line">{{ section.content }}</p>
            {% elseif not section.decision %}
                <p class="muted">Sin contenido.</p>
            {% endif %}
        </div>
    {% endfor %}

    <div class="card">
        <h2>Documento oficial (RG-09.03.01)</h2>
        <p>
            <a href="{{ path('management_review_pdf', { id: review.id }) }}" target="_blank" rel="noopener">
                {{ review.approved ? 'PDF oficial' : 'Vista previa del PDF' }}
            </a>
            {% if review.approved and review.integrityHash %}
                <span class="mono muted" title="Hash de integridad: {{ review.integrityHash|e('html_attr') }}">· {{ review.integrityHash|slice(0, 10) }}…</span>
            {% endif %}
        </p>
        {% if review.approved %}
            {% if review.digitallySigned %}
                <p>
                    <span class="badge badge--success" title="Firma digital adjunta">Firmada</span>
                    · <a href="{{ path('management_review_signed_download', { id: review.id }) }}">PDF firmado</a>
                </p>
                {% if can_write %}
                    <form method="post" enctype="multipart/form-data" action="{{ path('management_review_sign', { id: review.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('sign' ~ review.id) }}">
                        <input type="file" name="signedPdf" accept="application/pdf" aria-label="Reemplazar el PDF firmado">
                        <button class="btn secondary" type="submit">Reemplazar firma</button>
                    </form>
                {% endif %}
            {% elseif can_write %}
                <form method="post" enctype="multipart/form-data" action="{{ path('management_review_sign', { id: review.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('sign' ~ review.id) }}">
                    <input type="file" name="signedPdf" accept="application/pdf" aria-label="PDF firmado">
                    <button class="btn secondary" type="submit">Adjuntar firma</button>
                </form>
            {% endif %}
        {% endif %}
    </div>

    {% if not review.approved %}
        <div class="card">
            <form method="post" action="{{ path('management_review_approve', { id: review.id }) }}" data-confirm="¿Aprobar la revisión? Quedará firmada por la dirección y no podrá editarse.">
                <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ review.id) }}">
                <button class="btn" type="submit">Aprobar (firmar) la revisión</button>
            </form>
        </div>
    {% endif %}

    <div class="card">
        <form method="post" action="{{ path('management_review_delete', { id: review.id }) }}" data-confirm="¿Eliminar esta revisión por la dirección?">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ review.id) }}">
            <button class="btn danger" type="submit">Eliminar</button>
        </form>
    </div>

    {{ include('partials/_activity_log.html.twig', { entries: activity }) }}
{% endblock %}
