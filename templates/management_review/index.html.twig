{% extends 'app_shell.html.twig' %}

{% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::MANAGEMENT_REVIEW')) %}

{% block title %}Revisión por la dirección{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Revisión por la dirección{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Revisión por la dirección</h1>
            <p class="lead">Revisión anual del sistema de gestión ambiental (PG-09.03.00 / RG-09.03.01).</p>
        </div>
        {% if can_write %}
            <div>
                <a class="btn" href="{{ path('management_review_new') }}">+ Nueva revisión</a>
            </div>
        {% endif %}
    </div>

    {# Guía "qué falta este curso": pendientes del acta anual (crear → entradas §9.3.2 → decisiones
       §9.3.3 → reunión → aprobar → firmar), cada paso enlazado a donde se resuelve. Los pasos se
       calculan en ManagementReviewWorkflowStatusProvider; aquí solo se traducen a la estructura del
       partial común. #}
    {% set editable = status.exists and not status.approved and can_write %}
    {% set prerequisites_done = status.exists and status.inputsPending == 0 and status.decisionsPending == 0 and status.meetingRecorded %}
    {% set steps = [] %}

    {# 1 · Crear el acta #}
    {% set steps = steps|merge([{
        state: status.exists ? 'is-done' : 'is-pending',
        label: 'Crear el acta del curso ' ~ status.exercise,
        action: status.exists
            ? { type: 'link', style: 'plain', url: path('management_review_show', { id: status.reviewId }), text: 'ver el acta' }
            : (can_write
                ? { type: 'link', url: path('management_review_new'), text: 'Crear el acta ' ~ status.exercise }
                : { type: 'muted', text: 'Pendiente' })
    }]) %}

    {# 2 · Entradas §9.3.2 #}
    {% set steps = steps|merge([{
        state: not status.exists ? 'is-blocked' : (status.inputsPending > 0 ? 'is-pending' : 'is-done'),
        label: 'Completar los elementos de entrada',
        hint: '§9.3.2',
        action: not status.exists
            ? { type: 'muted', text: 'Requiere crear el acta' }
            : (status.inputsPending > 0
                ? (editable
                    ? { type: 'link', url: path('management_review_edit', { id: status.reviewId }), text: status.inputsPending ~ ' sin completar →' }
                    : { type: 'muted', text: status.inputsPending ~ ' sin completar' })
                : { type: 'muted', text: 'Hecho' })
    }]) %}

    {# 3 · Decisiones §9.3.3 #}
    {% set steps = steps|merge([{
        state: not status.exists ? 'is-blocked' : (status.decisionsPending > 0 ? 'is-pending' : 'is-done'),
        label: 'Registrar las decisiones',
        hint: '§9.3.3',
        action: not status.exists
            ? { type: 'muted', text: 'Requiere crear el acta' }
            : (status.decisionsPending > 0
                ? (editable
                    ? { type: 'link', url: path('management_review_edit', { id: status.reviewId }), text: status.decisionsPending ~ ' sin decidir →' }
                    : { type: 'muted', text: status.decisionsPending ~ ' sin decidir' })
                : { type: 'muted', text: 'Hecho' })
    }]) %}

    {# 4 · Reunión y participantes #}
    {% set steps = steps|merge([{
        state: not status.exists ? 'is-blocked' : (status.meetingRecorded ? 'is-done' : 'is-pending'),
        label: 'Registrar la reunión y sus participantes',
        action: not status.exists
            ? { type: 'muted', text: 'Requiere crear el acta' }
            : (status.meetingRecorded
                ? { type: 'muted', text: 'Hecho' }
                : (editable
                    ? { type: 'link', url: path('management_review_edit', { id: status.reviewId }), text: 'Registrar reunión →' }
                    : { type: 'muted', text: 'Pendiente' }))
    }]) %}

    {# 5 · Aprobar (firmar) #}
    {% set steps = steps|merge([{
        state: status.approved ? 'is-done' : (prerequisites_done ? 'is-pending' : 'is-blocked'),
        label: 'Aprobar y firmar el acta',
        hint: 'dirección',
        action: status.approved
            ? { type: 'muted', text: 'Hecho' }
            : (not status.exists
                ? { type: 'muted', text: 'Requiere crear el acta' }
                : (prerequisites_done
                    ? (can_write
                        ? { type: 'link', url: path('management_review_show', { id: status.reviewId }), text: 'Aprobar el acta →' }
                        : { type: 'muted', text: 'Pendiente' })
                    : { type: 'muted', text: 'Cuando el resto esté al día' }))
    }]) %}

    {# 6 · Firma digital nivel 1a (opcional) #}
    {% set steps = steps|merge([{
        state: not status.approved ? 'is-blocked' : (status.signed ? 'is-done' : 'is-pending'),
        label: 'Adjuntar la firma digital',
        hint: 'nivel 1a, opcional',
        action: not status.approved
            ? { type: 'muted', text: 'Requiere aprobar' }
            : (status.signed
                ? { type: 'muted', text: 'Hecho' }
                : (can_write
                    ? { type: 'link', style: 'plain', url: path('management_review_show', { id: status.reviewId }), text: 'adjuntar firma' }
                    : { type: 'muted', text: 'Pendiente' }))
    }]) %}

    {% include '_partials/_workflow_guide.html.twig' with { guide: {
        title: 'Acta del curso ' ~ status.exercise,
        subtitle: 'Qué hay que hacer aquí y qué te falta.',
        complete: status.isComplete,
        complete_label: 'Al día para ' ~ status.exercise,
        steps: steps,
    } } only %}

    <div class="card">
        {% if reviews is empty %}
            <div class="empty-state">
                <h2>Aún no hay revisiones</h2>
                <p>Crea la revisión por la dirección del curso en vigor.</p>
                {% if can_write %}<a class="btn" href="{{ path('management_review_new') }}">Crear la primera</a>{% endif %}
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr>
                        <th data-filter="curso">Curso</th><th>Fecha de reunión</th><th data-filter="estado">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {% for review in reviews %}
                        <tr>
                            <td><a class="cell-link" href="{{ path('management_review_show', { id: review.id }) }}">{{ review.exercise }}</a></td>
                            <td class="muted">{{ review.meetingDate ? review.meetingDate|date('d/m/Y') : '—' }}</td>
                            <td><span class="badge {{ review.status.badgeClass }}">{{ review.status.label }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
