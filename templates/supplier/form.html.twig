{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ isNew ? 'Registrar' : 'Editar' }} proveedor{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('supplier_index') }}">Proveedores</a><span class="sep">/</span>
    {{ isNew ? 'Registrar' : supplier.name }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ isNew ? 'Registrar proveedor' : 'Editar ' ~ supplier.name }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { 'attr': { 'novalidate': 'novalidate' } }) }}
            {{ form_errors(form) }}
            {{ f.fields([form.name, form.productOrService, form.notes]) }}
            {{ f.actions(path('supplier_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
