{% extends 'app_shell.html.twig' %}

{% block title %}{{ supplier.name }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('supplier_index') }}">Proveedores</a><span class="sep">/</span>
    {{ supplier.name }}
{% endblock %}

{% block body %}
    {% set can_write = is_granted('AREA_WRITE', constant('App\\Enum\\Area::SUPPLIER')) %}
    {% set evaluation = supplier.evaluationFor(currentYear) %}
    <div class="page-head">
        <div>
            <h1>{{ supplier.name }}
                {% if evaluation %}
                    <span class="badge {{ evaluation.criterion.badgeClass }}">{{ evaluation.criterion.label }} {{ currentYear }}</span>
                {% else %}
                    <span class="badge badge--draft">Sin evaluar {{ currentYear }}</span>
                {% endif %}
                {{ help_button('proveedor-evaluacion') }}
            </h1>
            <p class="lead">{{ supplier.productOrService }}</p>
        </div>
        <div class="page-actions">
            {% if can_write %}<a class="btn secondary" href="{{ path('supplier_edit', { id: supplier.id }) }}">Editar proveedor</a>{% endif %}
        </div>
    </div>

    {% if supplier.notes %}
        <div class="card">
            <h2>Observaciones</h2>
            <p>{{ supplier.notes|nl2br }}</p>
        </div>
    {% endif %}

    <div class="page-head">
        <h2>Evaluaciones anuales {{ help_button('proveedor-evaluacion') }}</h2>
        {% if can_write %}<a class="btn" href="{{ path('supplier_evaluation_new', { id: supplier.id }) }}">+ Añadir evaluación</a>{% endif %}
    </div>

    <div class="card">
        {% if supplier.evaluations is empty %}
            <div class="empty-state">
                <h2>Aún no hay evaluaciones</h2>
                <p>Registra la evaluación del proveedor para el año en curso.</p>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Año</th><th>Evaluación</th><th>Observaciones</th>{% if can_write %}<th></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for ev in supplier.evaluations %}
                        <tr>
                            <td class="mono">{{ ev.year }}{% if ev.year == currentYear %} <span class="muted">· en curso</span>{% endif %}</td>
                            <td><span class="badge {{ ev.criterion.badgeClass }}">{{ ev.criterion.label }}</span> <span class="muted">· {{ ev.criterion.statusLabel }}</span></td>
                            <td class="muted">{{ ev.notes ?? '—' }}</td>
                            {% if can_write %}<td><a href="{{ path('supplier_evaluation_edit', { id: supplier.id, evaluationId: ev.id }) }}">Editar</a></td>{% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    <div class="page-head">
        <h2>Incidencias {{ help_button('proveedor-incidencia') }}</h2>
        {% if can_write %}<a class="btn" href="{{ path('supplier_incident_new', { id: supplier.id }) }}">+ Añadir incidencia</a>{% endif %}
    </div>

    <div class="card">
        {% if supplier.incidents is empty %}
            <div class="empty-state">
                <h2>Sin incidencias registradas</h2>
                <p>Registra aquí los problemas de plazo, calidad o cumplimiento del proveedor.</p>
            </div>
        {% else %}
            {# Las incidencias tienen textos largos (descripción, resolución): fichas, no tabla. #}
            {% for incident in supplier.incidents %}
                <div class="action-item">
                    <p class="action-desc">{{ incident.description|nl2br }}</p>
                    <div class="action-meta">
                        <span class="meta-item"><span class="meta-label">Fecha</span>{{ incident.occurredOn|date('d/m/Y') }}</span>
                        <span class="meta-item"><span class="meta-label">Gravedad</span>
                            {%- if incident.severe -%}<span class="badge badge--danger">Grave</span>{%- else -%}<span class="muted">Normal</span>{%- endif -%}
                        </span>
                        <span class="meta-item"><span class="meta-label">Resolución</span>
                            {%- if incident.resolution -%}<span class="badge badge--success">Resuelta</span>{%- else -%}<span class="badge badge--warning">Pendiente</span>{%- endif -%}
                        </span>
                    </div>
                    {% if incident.resolution %}
                        <div class="action-efficacy"><span class="meta-label">Resolución</span>{{ incident.resolution|nl2br }}</div>
                    {% endif %}
                    <div class="action-actions">
                        {% if incident.severe and can_write %}
                            <a href="{{ path('non_conformity_new', { origin: 'internal', description: 'Incidencia con proveedor ' ~ supplier.name ~ ': ' ~ incident.description }) }}">Abrir NC</a>
                        {% endif %}
                        {% if can_write %}<a href="{{ path('supplier_incident_edit', { id: supplier.id, incidentId: incident.id }) }}">Editar incidencia</a>{% endif %}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
